---
// Broken-page intro: the site is "stuck in safe mode" and overrun by bugs.
// Visitors get in by turning safe mode off: type it in the recovery console or flip the hidden switch.
// Solved once per browser (localStorage); "Replay intro" in the footer brings it back.
---
<script is:inline>
  (function () {
    var root = document.documentElement, skip = false;
    try { skip = localStorage.getItem('tr-intro-seen') === '1'; } catch (e) {}
    root.classList.add(skip ? 'no-intro' : 'intro-on');
  })();
</script>

<div id="intro" role="dialog" aria-modal="true" aria-labelledby="bk-title">
  <div class="bk-noise" aria-hidden="true"></div>

  <!-- the "broken" homepage underneath -->
  <div class="bk-page" aria-hidden="true">
    <p class="bk-eyebrow">A COMMUNITY FOR CURIOUS PEOPLE IN TECH · PRAGUE</p>
    <p class="bk-word" data-text="tech">tech</p>
    <p class="bk-word bk-word2" data-text="Rebels">Rebels</p>
    <p class="bk-claim">Rebels don't do <span>s̷a̴f̶e̵ ̷m̸o̵d̷e̶</span>.</p>
  </div>

  <!-- error windows -->
  <div class="bk-win w1" aria-hidden="true">
    <div class="bk-bar"><i></i><i></i><i></i><span>bugs.log</span></div>
    <p><b>Uncaught BugException:</b> too many rebels in production.</p>
    <p class="mono">at techRebels.os:404:1337</p>
  </div>
  <div class="bk-win w2" aria-hidden="true">
    <div class="bk-bar"><i></i><i></i><i></i><span>kernel.panic</span></div>
    <p><b>Segmentation fault</b> (core dumped)</p>
    <p class="mono">fun.exe has stopped responding</p>
  </div>
  <div class="bk-win w3" aria-hidden="true">
    <div class="bk-bar"><i></i><i></i><i></i><span>teapot.err</span></div>
    <p><b>Error 418:</b> I'm a teapot. Also, the carnival is closed.</p>
  </div>
  <div class="bk-win w4 bk-safe">
    <div class="bk-bar" aria-hidden="true"><i></i><i></i><i></i><span>settings.sys</span></div>
    <p class="bk-safe-row">
      <span id="bk-safe-label">SAFE MODE</span>
      <button type="button" role="switch" aria-checked="true" aria-labelledby="bk-safe-label" id="bk-switch" class="bk-switch"><span class="knob"></span><span class="txt">ON</span></button>
    </p>
    <p class="mono" aria-hidden="true">boring = true</p>
  </div>

  <!-- recovery console -->
  <section class="bk-term" aria-labelledby="bk-title">
    <div class="bk-bar" aria-hidden="true"><i></i><i></i><i></i><span>techRebels.os · recovery console</span></div>
    <h2 id="bk-title" class="sr-only">techRebels is broken. Fix it to get in.</h2>
    <div class="bk-log" id="bk-log" aria-live="polite">
      <p><span class="err">!</span> system unstable. 404 bugs detected.</p>
      <p><span class="err">!</span> the site is stuck in <b>safe mode</b>.</p>
      <p>&gt; fix it to get in.</p>
    </div>
    <form class="bk-prompt" id="bk-form" autocomplete="off">
      <label for="bk-input"><span class="ps">rebel@techrebels:~$</span></label>
      <input id="bk-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" maxlength="60" aria-label="Type a command" />
      <span class="caret" aria-hidden="true"></span>
    </form>
  </section>

  <!-- hint -->
  <div class="bk-hint">
    <button type="button" id="bk-hint-btn" aria-expanded="false" aria-controls="bk-hint-note">Need a hint?</button>
    <div class="bk-note" id="bk-hint-note" hidden>
      <p id="bk-hint-text"></p>
      <button type="button" id="bk-hint-more">Another hint</button>
    </div>
  </div>

  <p class="bk-status" aria-hidden="true">BUGS: 404 · SAFE MODE: <b id="bk-status-safe">ON</b> · STATUS: WON'T FIX</p>

  <div class="bk-bugs" id="bk-bugs" aria-hidden="true"></div>
  <div class="slices" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
</div>

<style is:global>
  html.no-intro #intro { display: none; }
  html.intro-on, html.intro-on body { overflow: hidden; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  #intro { position: fixed; inset: 0; z-index: 100; background: var(--night); color: var(--bone); font-family: var(--f-mono); overflow: hidden; }
  #intro .bk-noise { position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px); animation: bk-roll 7s linear infinite; }
  @keyframes bk-roll { to { background-position: 0 300px; } }

  /* broken homepage */
  .bk-page { position: absolute; left: clamp(16px, 6vw, 96px); top: clamp(70px, 14vh, 150px); right: 16px; pointer-events: none; }
  .bk-eyebrow { margin: 0 0 14px; font-size: .78rem; letter-spacing: .14em; color: var(--muted); animation: bk-jit 2.6s steps(2) infinite; }
  .bk-word { position: relative; margin: 0; font: 800 clamp(4.2rem, 15vw, 14rem)/.8 var(--f-display); letter-spacing: -.055em; color: var(--pink); }
  .bk-word::before, .bk-word::after { content: attr(data-text); position: absolute; inset: 0; }
  .bk-word::before { color: var(--mint); transform: translate(-4px, 0); clip-path: inset(10% 0 55% 0); animation: bk-slice 1.9s steps(3) infinite; mix-blend-mode: screen; }
  .bk-word::after { color: var(--lime); transform: translate(5px, 0); clip-path: inset(62% 0 8% 0); animation: bk-slice 2.4s steps(4) infinite reverse; mix-blend-mode: screen; }
  .bk-word2 { margin-left: clamp(8px, 3vw, 40px); animation: bk-jit 3.1s steps(2) infinite; }
  .bk-claim { margin: 22px 0 0; font: 700 clamp(1.1rem, 2.4vw, 1.9rem) var(--f-display); color: var(--bone); opacity: .85; }
  .bk-claim span { color: var(--pink); }
  @keyframes bk-slice {
    0% { clip-path: inset(10% 0 55% 0); transform: translate(-4px, 0); }
    33% { clip-path: inset(40% 0 30% 0); transform: translate(6px, -2px); }
    66% { clip-path: inset(75% 0 5% 0); transform: translate(-7px, 2px); }
    100% { clip-path: inset(20% 0 60% 0); transform: translate(3px, 0); }
  }
  @keyframes bk-jit { 0%, 92% { transform: none; } 94% { transform: translate(-6px, 1px) skewX(-8deg); } 97% { transform: translate(5px, -1px); } }

  /* windows */
  .bk-win, .bk-term { position: absolute; background: var(--night-2); border: 1.5px solid rgba(237, 231, 220, .22); border-radius: 12px; box-shadow: 6px 6px 0 var(--purple), 0 20px 50px rgba(0, 0, 0, .5); transition: transform .45s cubic-bezier(.6, -0.3, .7, 1.4), opacity .35s; }
  .bk-win p { margin: 0; padding: 10px 14px 0; font-size: .82rem; line-height: 1.45; }
  .bk-win p:last-child { padding-bottom: 12px; }
  .bk-win .mono { color: var(--muted); font-size: .74rem; }
  .bk-bar { display: flex; align-items: center; gap: 6px; padding: 7px 10px; border-bottom: 1px solid rgba(237, 231, 220, .14); font-size: .7rem; color: var(--muted); }
  .bk-bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--pink); }
  .bk-bar i:nth-child(2) { background: var(--lime); }
  .bk-bar i:nth-child(3) { background: var(--mint); }
  .bk-bar span { margin-left: 6px; }
  .w1 { width: 280px; right: 8%; top: 22%; transform: rotate(3deg); box-shadow: 6px 6px 0 var(--pink), 0 20px 50px rgba(0, 0, 0, .5); }
  .w2 { width: 250px; left: 4%; bottom: 14%; transform: rotate(-4deg); animation: bk-jit 4s steps(2) infinite; }
  .w3 { width: 240px; right: 4%; bottom: 10%; transform: rotate(-2deg); box-shadow: 6px 6px 0 var(--lime), 0 20px 50px rgba(0, 0, 0, .5); }
  .w4 { width: 230px; left: 44%; top: 9%; transform: rotate(2.5deg); box-shadow: 6px 6px 0 var(--mint), 0 20px 50px rgba(0, 0, 0, .5); }
  .bk-safe-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 700; }
  .bk-switch { position: relative; width: 74px; height: 32px; border-radius: 999px; border: 2px solid var(--bone); background: var(--pink); cursor: pointer; padding: 0; font: 700 .72rem var(--f-mono); color: var(--night); }
  .bk-switch .knob { position: absolute; top: 3px; right: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--night); transition: right .25s; }
  .bk-switch .txt { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); }
  .bk-switch[aria-checked="false"] { background: var(--lime); }
  .bk-switch[aria-checked="false"] .knob { right: 45px; }
  .bk-switch[aria-checked="false"] .txt { left: auto; right: 10px; }
  .bk-switch:focus-visible { outline: 3px solid var(--lime); outline-offset: 3px; }

  /* console */
  .bk-term { left: 50%; top: 58%; transform: translate(-50%, -50%); width: min(640px, calc(100% - 32px)); box-shadow: 8px 8px 0 var(--lime), 0 30px 70px rgba(0, 0, 0, .6); z-index: 5; }
  .bk-log { padding: 14px 18px 4px; font-size: .9rem; line-height: 1.6; max-height: 34vh; overflow: auto; }
  .bk-log p { margin: 0; }
  .bk-log b { color: var(--pink); }
  .bk-log .err { color: var(--pink); font-weight: 700; }
  .bk-log .ok { color: var(--mint); }
  .bk-log .you { color: var(--lime); }
  .bk-log .no { color: #FF9C9C; }
  .bk-prompt { display: flex; align-items: center; gap: 10px; padding: 8px 18px 16px; font-size: .95rem; }
  .bk-prompt .ps { color: var(--mint); white-space: nowrap; }
  .bk-prompt input { flex: 1; min-width: 0; background: transparent; border: 0; outline: none; color: var(--lime); font: 700 .95rem var(--f-mono); caret-color: var(--lime); }
  .bk-prompt:focus-within { box-shadow: inset 0 -2px 0 var(--lime); }

  /* hint */
  .bk-hint { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 16px); right: 16px; z-index: 20; display: grid; justify-items: end; gap: 10px; }
  #bk-hint-btn { font: 700 .85rem var(--f-mono); color: var(--night); background: var(--lime); border: 0; border-radius: 999px; padding: 10px 16px; cursor: pointer; box-shadow: 0 0 0 0 rgba(205, 220, 39, .6); animation: bk-pulse 2.2s ease-in-out infinite; }
  @keyframes bk-pulse { 50% { box-shadow: 0 0 0 10px rgba(205, 220, 39, 0); } }
  .bk-note { width: min(280px, calc(100vw - 32px)); background: var(--pink); color: var(--night); padding: 16px; transform: rotate(2deg); box-shadow: 0 14px 30px rgba(0, 0, 0, .4); display: grid; gap: 10px; }
  .bk-note[hidden] { display: none; }
  .bk-note p { margin: 0; font: 700 .95rem/1.35 var(--f-mono); }
  #bk-hint-more { justify-self: start; background: var(--night); color: var(--pink); border: 0; border-radius: 999px; padding: 7px 12px; font: 700 .75rem var(--f-mono); cursor: pointer; }
  #bk-hint-more[hidden] { display: none; }

  .bk-status { position: absolute; left: 16px; bottom: calc(env(safe-area-inset-bottom, 0px) + 12px); margin: 0; font-size: .72rem; letter-spacing: .1em; color: var(--muted); }
  .bk-status b { color: var(--pink); }

  /* bugs crawling over everything */
  .bk-bugs { position: absolute; inset: 0; pointer-events: none; z-index: 8; }
  .bk-bug { position: absolute; width: 58px; }
  .bk-bug svg { display: block; width: 100%; height: auto; }
  .bk-bug.c1 { animation: bk-crawl1 9s ease-in-out infinite alternate; }
  .bk-bug.c2 { animation: bk-crawl2 11s ease-in-out infinite alternate; }
  .bk-bug.c3 { animation: bk-crawl3 7s ease-in-out infinite alternate; }
  @keyframes bk-crawl1 { 0% { transform: translate(0, 0) rotate(-10deg); } 50% { transform: translate(60px, 30px) rotate(15deg); } 100% { transform: translate(-40px, 70px) rotate(-25deg); } }
  @keyframes bk-crawl2 { 0% { transform: translate(0, 0) rotate(20deg); } 50% { transform: translate(-80px, -20px) rotate(-10deg); } 100% { transform: translate(30px, -60px) rotate(30deg); } }
  @keyframes bk-crawl3 { 0% { transform: translate(0, 0) rotate(0); } 100% { transform: translate(90px, -40px) rotate(40deg); } }

  /* fixed: everything snaps into place, then the screen tears away */
  #intro.fixed .bk-word::before, #intro.fixed .bk-word::after { animation: none; opacity: 0; }
  #intro.fixed .bk-word2, #intro.fixed .bk-eyebrow, #intro.fixed .w2 { animation: none; }
  #intro.fixed .bk-claim span { color: var(--lime); }
  #intro .bk-win.closed { transform: scale(0) rotate(20deg) !important; opacity: 0; }
  #intro.fixed .bk-bug { transition: transform 1.2s ease-in, opacity 1.2s; opacity: 0; }
  #intro .slices { position: absolute; inset: 0; display: grid; grid-template-rows: repeat(8, 1fr); pointer-events: none; z-index: 30; }
  #intro .slices i { background: transparent; }
  #intro.tear { background: transparent; }
  #intro.tear > :not(.slices) { opacity: 0; transition: opacity .25s; }
  #intro.tear .slices i { background: var(--night); transition: transform .75s cubic-bezier(.75, 0, .25, 1); }
  #intro.tear.go .slices i:nth-child(odd) { transform: translateX(-105%); }
  #intro.tear.go .slices i:nth-child(even) { transform: translateX(105%); }

  @media (max-width: 760px) {
    .w1 { display: none; }
    .w2 { display: none; }
    .w3 { display: none; }
    .w4 { left: auto; right: 4%; top: auto; bottom: calc(env(safe-area-inset-bottom, 0px) + 44px); width: 210px; }
    .bk-term { top: 56%; }
    .bk-word { font-size: clamp(3.4rem, 22vw, 6rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    #intro *, #intro *::before, #intro *::after { animation: none !important; }
  }
</style>

<script>
  import { bugSVG } from '../lib/bug/render.js';

  const root = document.documentElement;
  const intro = document.getElementById('intro');

  const entered = () => {
    root.classList.remove('intro-on');
    root.classList.add('entered');
    document.dispatchEvent(new CustomEvent('tr:entered'));
  };

  if (!intro || root.classList.contains('no-intro')) {
    intro?.remove();
    entered();
  } else {
    run(intro);
  }

  function run(intro: HTMLElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const log = $('bk-log');
    const input = $('bk-input') as HTMLInputElement;
    const sw = $('bk-switch') as HTMLButtonElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let solved = false, wrong = 0, hintLevel = 0;

    // bugs on the broken page
    const BUGS = [
      { at: 'left:12%;top:58%', cls: 'c1', cfg: { role: 'dev', shape: 'round', shell: 'pink', pattern: 'code', eyes: 'glitch', mouth: 'zigzag', antennae: 'plug', pose: 'stomp', attitude: 'rebel' } },
      { at: 'left:62%;top:30%', cls: 'c2', cfg: { role: 'ai', shape: 'tall', shell: 'lime', pattern: 'circuit', eyes: 'pixel', mouth: 'o', antennae: 'wifi', pose: 'hype', attitude: 'excited' } },
      { at: 'left:80%;top:62%', cls: 'c3', cfg: { role: 'curious', shape: 'wide', shell: 'mint', pattern: 'dots', eyes: 'googly', mouth: 'fangs', antennae: 'classic', pose: 'jump' } },
      { at: 'left:30%;top:18%', cls: 'c2', cfg: { role: 'security', shape: 'round', shell: 'purple', pattern: 'pixels', eyes: 'visor', mouth: 'grin', antennae: 'cursor', pose: 'wave', attitude: 'smug' } },
      { at: 'left:50%;top:78%', cls: 'c1', cfg: { role: 'product', shape: 'tall', shell: 'green', pattern: 'stripes', eyes: 'sleepy', mouth: 'smirk', antennae: 'match', pose: 'lean', attitude: 'worried' } },
      { at: 'left:88%;top:40%', cls: 'c3', cfg: { role: 'marketing', shape: 'round', shell: 'brown', pattern: 'dots', eyes: 'hearts', mouth: 'tongue', antennae: 'match', pose: 'wave' } },
    ];
    $('bk-bugs').innerHTML = BUGS.map((b) => `<div class="bk-bug ${b.cls}" style="${b.at}">${bugSVG(b.cfg, 80)}</div>`).join('');

    const say = (text: string, cls = '') => {
      const p = document.createElement('p');
      if (cls) p.className = cls;
      p.textContent = text;
      log.appendChild(p);
      log.scrollTop = log.scrollHeight;
    };
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

    // ---------- hints ----------
    const HINTS = [
      "Rebels don't do safe mode.",
      'Turn it off. Type it in the console, or find the switch.',
      'Type: safe mode off',
    ];
    const showHint = () => {
      const note = $('bk-hint-note');
      note.hidden = false;
      $('bk-hint-btn').setAttribute('aria-expanded', 'true');
      $('bk-hint-text').textContent = HINTS[Math.min(hintLevel, HINTS.length - 1)];
      $('bk-hint-more').hidden = hintLevel >= HINTS.length - 1;
      document.dispatchEvent(new CustomEvent('tr:intro', { detail: `hint-${hintLevel + 1}` }));
    };
    $('bk-hint-btn').addEventListener('click', () => {
      const note = $('bk-hint-note');
      if (!note.hidden) { note.hidden = true; $('bk-hint-btn').setAttribute('aria-expanded', 'false'); return; }
      showHint();
    });
    $('bk-hint-more').addEventListener('click', () => { hintLevel = Math.min(hintLevel + 1, HINTS.length - 1); showHint(); });

    // ---------- console ----------
    const NOPE = [
      'Nope. Still broken.',
      'Close, but the bugs are laughing.',
      'That did nothing. Rebels would try something bolder.',
      'Command accepted. Just kidding, still broken.',
    ];
    const solves = (cmd: string) => {
      const c = cmd.replace(/[^a-z ]/g, ' ').replace(/\s+/g, ' ').trim();
      if (/sudo make it fun/.test(c)) return true;
      return /safe ?mode/.test(c) && /\b(off|disable|disabled|exit|stop|kill|false|0)\b/.test(c);
    };

    $('bk-form').addEventListener('submit', (e) => {
      e.preventDefault();
      if (solved) return;
      const raw = input.value.slice(0, 60);
      input.value = '';
      const cmd = raw.toLowerCase().trim();
      if (!cmd) return;
      say(`$ ${raw}`, 'you');
      if (solves(cmd)) { solve(); return; }
      if (cmd === 'help') { say('commands: help, hint, ls, whoami, cat <file>, clear'); return; }
      if (cmd === 'hint') { showHint(); say('> a hint appeared in the corner.'); return; }
      if (cmd === 'ls') { say('manifesto.txt   bugs/   safe_mode.lock   fun.exe'); return; }
      if (cmd === 'whoami') { say('a rebel, apparently. rebels do not do safe mode.'); return; }
      if (cmd === 'clear') { log.replaceChildren(); return; }
      if (cmd.startsWith('cat safe_mode')) { say('safe_mode.lock: "Rebels don\'t do safe mode. Turn it off."'); return; }
      if (cmd.startsWith('cat manifesto')) { say('manifesto.txt: "Real projects. Real bugs. Zero status games."'); return; }
      if (cmd.startsWith('cat ')) { say(`cat: ${raw.slice(4)}: no such file. Only bugs here.`, 'no'); return; }
      if (/^(sudo )?rm /.test(cmd)) { say('nice try. the bugs are load-bearing.', 'no'); return; }
      if (/^(exit|quit|q)$/.test(cmd)) { say('there is no exit. only safe mode, and you know how we feel about that.', 'no'); return; }
      wrong++;
      say(`${cmd.split(' ')[0]}: command not found. ${NOPE[(wrong - 1) % NOPE.length]}`, 'no');
      if (wrong === 3 && $('bk-hint-note').hidden) showHint();
    });

    sw.addEventListener('click', () => { if (!solved) solve('switch'); });

    // ---------- fixed ----------
    async function solve(how = 'console') {
      solved = true;
      input.disabled = true;
      sw.setAttribute('aria-checked', 'false');
      sw.querySelector('.txt')!.textContent = 'OFF';
      $('bk-status-safe').textContent = 'OFF';
      try { localStorage.setItem('tr-intro-seen', '1'); } catch {}
      document.dispatchEvent(new CustomEvent('tr:intro', { detail: `solved-${how}` }));
      intro.classList.add('fixed');
      say('> disabling safe mode... done', 'ok');
      await sleep(350);
      say('> patching 404 bugs... won\'t fix, they\'re family', 'ok');
      document.querySelectorAll<HTMLElement>('.bk-bug').forEach((b, i) => {
        b.style.animation = 'none';
        b.style.transform = `translate(${i % 2 ? 140 : -140}vw, ${i % 3 ? -60 : 60}vh) rotate(${i * 90}deg)`;
      });
      for (const w of document.querySelectorAll<HTMLElement>('.bk-win')) { await sleep(160); w.classList.add('closed'); }
      await sleep(250);
      say('> patch applied. welcome, rebel.', 'ok');
      await sleep(900);
      intro.classList.add('tear');
      requestAnimationFrame(() => requestAnimationFrame(() => intro.classList.add('go')));
      root.classList.remove('intro-on');
      setTimeout(() => { intro.remove(); entered(); }, reduce ? 0 : 1000);
    }

    setTimeout(() => input.focus({ preventScroll: true }), 300);
  }
</script>
