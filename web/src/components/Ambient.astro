---
// Ambient bug layer: small canvas bugs wander over the page and flee the cursor.
// Clicking empty space spawns a bug. Starts after the intro (event tr:entered).
---
<canvas id="ambient" aria-hidden="true"></canvas>

<style>
  #ambient { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }
</style>

<script>
  import { Swarm } from '../lib/swarm/canvasBugs';

  const canvas = document.getElementById('ambient') as HTMLCanvasElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const emit = (n: number) => document.dispatchEvent(new CustomEvent('tr:count', { detail: n }));

  if (!canvas || reduce) {
    canvas?.remove();
    emit(0);
  } else {
    const sw = new Swarm(canvas, 250);
    let mx = -9999, my = -9999, running = false;

    // tx = base speed, ty = wander heading (the ambient layer has no targets)
    const spawn = (x: number, y: number, burst = false, silent = false) => {
      const a = Math.random() * Math.PI * 2;
      const sp = burst ? 3 + Math.random() * 2 : 0.6 + Math.random() * 0.6;
      const i = sw.add(x, y, Math.cos(a) * sp, Math.sin(a) * sp, 3 + Math.random() * 2);
      if (i >= 0) { sw.tx[i] = 0.6 + Math.random() * 0.7; sw.ty[i] = a; }
      if (!silent) emit(sw.n);
    };

    const frame = () => {
      requestAnimationFrame(frame);
      if (document.hidden) return;
      const { W, H } = sw;
      for (let i = 0; i < sw.n; i++) {
        sw.ty[i] += (Math.random() - 0.5) * 0.35;
        let vx = sw.vx[i] + Math.cos(sw.ty[i]) * 0.06;
        let vy = sw.vy[i] + Math.sin(sw.ty[i]) * 0.06;
        const ex = sw.x[i] - mx, ey = sw.y[i] - my, d2 = ex * ex + ey * ey;
        let limit = sw.tx[i];
        if (d2 < 12100 && d2 > 0.01) {
          const d = Math.sqrt(d2), f = (110 - d) / 110;
          vx += (ex / d) * f * 1.2; vy += (ey / d) * f * 1.2;
          limit = 3.5;
          sw.ty[i] = Math.atan2(ey, ex);
        }
        const m = 14;
        if (sw.x[i] < m) { vx += 0.25; sw.ty[i] = 0; }
        if (sw.x[i] > W - m) { vx -= 0.25; sw.ty[i] = Math.PI; }
        if (sw.y[i] < m + 40) { vy += 0.25; sw.ty[i] = Math.PI / 2; }
        if (sw.y[i] > H - m) { vy -= 0.25; sw.ty[i] = -Math.PI / 2; }
        const sp = Math.hypot(vx, vy);
        if (sp > limit) { vx *= 0.92; vy *= 0.92; }
        sw.vx[i] = vx; sw.vy[i] = vy;
        sw.step(i);
      }
      sw.draw();
    };

    const start = () => {
      if (running) return;
      running = true;
      sw.resize();
      const initial = Number(canvas.dataset.count) || 10;
      for (let k = 0; k < initial; k++) spawn(40 + Math.random() * (sw.W - 80), 80 + Math.random() * (sw.H - 120), false, true);
      setTimeout(() => emit(sw.n), 0); // listeners in later scripts may not exist yet
      requestAnimationFrame(frame);
    };

    addEventListener('resize', () => sw.resize());
    addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
    document.addEventListener('pointerleave', () => { mx = my = -9999; });

    document.addEventListener('pointerdown', (e) => {
      const t = e.target as Element | null;
      if (!running || t?.closest('a, button, input, select, textarea, label, summary, details, .win-bar, #intro')) return;
      spawn(e.clientX, e.clientY, true);
    });

    document.addEventListener('tr:release', (e) => {
      const n = (e as CustomEvent<number>).detail || 50;
      for (let k = 0; k < n; k++) spawn(sw.W / 2 + (Math.random() - 0.5) * 120, sw.H / 2 + (Math.random() - 0.5) * 120, true);
    });

    if (document.documentElement.classList.contains('entered')) start();
    else document.addEventListener('tr:entered', start, { once: true });
  }
</script>
