---
interface Props { active: string }
const { active } = Astro.props;
const items = [
  ['overview', '/inside/admin', 'Overview'],
  ['applications', '/inside/admin/applications', 'Applications'],
  ['invitations', '/inside/admin/invitations', 'Invitations'],
  ['people', '/inside/admin/people', 'People'],
  ['matching', '/inside/admin/matching', 'Matching'],
  ['content', '/inside/admin/content', 'Content'],
  ['insights', '/inside/admin/insights', 'Insights'],
] as const;
---
<nav class="admin-nav" aria-label="Control Room sections">
  {items.map(([id, href, label]) => <a href={href} aria-current={active === id ? 'page' : undefined}>{label}</a>)}
</nav>

<style is:global>
  .admin-nav { position: sticky; top: 76px; z-index: 24; display: flex; gap: 7px; margin: 0 0 20px; padding: 8px; overflow-x: auto; border: 1px solid rgba(var(--fg-rgb), .1); border-radius: 18px; background: rgba(var(--bg2-rgb), .92); backdrop-filter: blur(14px); }
  .admin-nav a { flex: none; padding: 8px 13px; border-radius: 999px; color: var(--muted); text-decoration: none; font: 650 .75rem var(--f-mono); }
  .admin-nav a:hover, .admin-nav a[aria-current="page"] { color: var(--night); background: var(--lime); }
  @media (max-width: 760px) { .admin-nav { top: 68px; } }
</style>
