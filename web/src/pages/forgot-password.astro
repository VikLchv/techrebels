---
import Club from '../layouts/Club.astro';
---
<Club title="Reset password · techRebels" description="Request a secure techRebels password reset.">
  <section class="block first auth-page">
    <div class="auth-card">
      <p class="eyebrow">Account recovery</p>
      <h1 class="h2">Reset your password.</h1>
      <p class="lede">Enter your account email. We’ll send a short-lived reset link if an account exists.</p>
      <form id="forgot-form" novalidate>
        <label>Email<input type="email" id="forgot-email" required autocomplete="email" maxlength="120" /></label>
        <p class="lerr" id="forgot-error" role="alert" hidden></p>
        <button class="pill pill-pink" id="forgot-submit" type="submit">Send reset link <span aria-hidden="true">→</span></button>
      </form>
      <div class="auth-done" id="forgot-done" role="status" hidden>
        <h2>Check your inbox.</h2>
        <p>If an account exists for that email, a password reset link is on its way.</p>
      </div>
      <a class="auth-back" href="/login">← Back to login</a>
    </div>
  </section>
</Club>

<style is:global>
  .auth-card { max-width: 620px; display: grid; gap: 18px; }
  .auth-card form { display: grid; gap: 14px; }
  .auth-card label { display: grid; gap: 7px; font-weight: 700; }
  .auth-card input { width: 100%; border: 1.5px solid rgba(var(--fg-rgb), .16); border-radius: 14px; padding: 13px 15px; background: var(--bg-2); color: var(--fg); font: 500 1rem "Satoshi", system-ui, sans-serif; }
  .auth-card input:focus { outline: none; border-color: var(--lime); }
  .auth-card .pill { justify-self: start; }
  .auth-card .lerr { margin: 0; color: var(--pink-text); font-weight: 700; }
  .auth-done { padding: 18px; border: 1.5px solid var(--lime); border-radius: 18px; }
  .auth-done h2 { margin: 0 0 6px; color: var(--lime-text); font: 800 1.6rem var(--f-display); }
  .auth-done p { margin: 0; color: var(--soft); }
  .auth-back { color: var(--mint-text); justify-self: start; }
</style>

<script>
  import { supabase } from '../lib/supabase';
  const form = document.getElementById('forgot-form') as HTMLFormElement;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = document.getElementById('forgot-email') as HTMLInputElement;
    const errorBox = document.getElementById('forgot-error')!;
    errorBox.hidden = true;
    if (!email.value || !email.checkValidity()) { errorBox.textContent = 'Please enter a valid email.'; errorBox.hidden = false; email.focus(); return; }
    if (!supabase) { errorBox.textContent = 'Account recovery is not connected on this site yet.'; errorBox.hidden = false; return; }
    const button = document.getElementById('forgot-submit') as HTMLButtonElement;
    button.disabled = true;
    const { error } = await supabase.auth.resetPasswordForEmail(email.value.trim(), { redirectTo: `${location.origin}/reset-password` });
    button.disabled = false;
    if (error?.status === 429) { errorBox.textContent = 'Too many attempts. Try again in a few minutes.'; errorBox.hidden = false; return; }
    if (error) { errorBox.textContent = 'The reset request could not be sent. Try again shortly.'; errorBox.hidden = false; return; }
    form.hidden = true;
    document.getElementById('forgot-done')!.hidden = false;
  });
</script>
