---
// Rebel Radar: topics and types of people we want at Rebel Sessions, as flying bugs.
import Club from '../layouts/Club.astro';
---
<Club title="Rebel Radar · techRebels" description="Topics and people we want at Rebel Sessions. Vote, tip a guest, suggest a topic.">
  <section class="block first radar-page">
    <div class="head">
      <p class="eyebrow">Rebel Radar</p>
      <h1 class="h2">What should we talk about?</h1>
      <p class="lede">Every bug carries a topic or a kind of person we want at Rebel Sessions. Catch one to vote or tip a guest. The more votes, the bigger the bug and the closer it flies to the center.</p>
    </div>

    <div class="rd-filters" role="group" aria-label="Filter the radar">
      <button type="button" class="rd-f" data-f="all" aria-pressed="true">All</button>
      <button type="button" class="rd-f" data-f="topic" aria-pressed="false">Topics</button>
      <button type="button" class="rd-f" data-f="person" aria-pressed="false">People</button>
      <span class="rd-sep" aria-hidden="true"></span>
      <button type="button" class="rd-f" data-f="bugs" aria-pressed="false"><i class="dot" style="background:var(--purple)"></i>Bugs</button>
      <button type="button" class="rd-f" data-f="rebels" aria-pressed="false"><i class="dot" style="background:var(--green)"></i>Rebels</button>
      <button type="button" class="rd-f" data-f="lunapark" aria-pressed="false"><i class="dot" style="background:var(--lime)"></i>Lunapark</button>
    </div>

    <div class="rd-wrap">
      <div class="rd-stage" id="rd-stage" aria-hidden="true">
        <p class="rd-center"><span>tech</span><span>Rebels</span></p>
        <p class="rd-loading" id="rd-loading">Scanning for bugs...</p>
      </div>

      <aside class="rd-card" id="rd-card" hidden aria-live="polite">
        <button type="button" class="rd-close" id="rd-close" aria-label="Close">×</button>
        <div class="rd-card-bug" id="rd-card-bug"></div>
        <p class="rd-meta" id="rd-meta"></p>
        <h2 id="rd-title"></h2>
        <p class="rd-desc" id="rd-desc"></p>
        <p class="rd-votes"><b id="rd-votes">0</b> <span id="rd-votes-label">votes</span></p>
        <div class="rd-actions">
          <button type="button" class="pill pill-pink" id="rd-vote">I want this</button>
          <button type="button" class="pill pill-ghost" id="rd-tip-open">I know someone</button>
        </div>
        <p class="rd-note" id="rd-note" role="status"></p>
        <form class="rd-tip" id="rd-tip" hidden novalidate>
          <p class="rd-tip-h">Who should we invite? Only the crew sees this.</p>
          <label>Who<input name="who" id="tip-who" required maxlength="120" placeholder="Name, role, company" /></label>
          <label>Why them <span class="opt">optional</span><textarea name="why" id="tip-why" rows="2" maxlength="600"></textarea></label>
          <label>Link <span class="opt">optional</span><input name="link" id="tip-link" type="url" maxlength="300" placeholder="https://" /></label>
          <div class="f2">
            <label>Your name<input name="name" id="tip-name" required maxlength="80" autocomplete="name" /></label>
            <label>Your email<input name="email" id="tip-email" type="email" required maxlength="120" autocomplete="email" /></label>
          </div>
          <label class="check"><input type="checkbox" id="tip-consent" required /> I agree that techRebels may contact me about this tip.</label>
          <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <button class="pill pill-lime" type="submit">Send tip <span aria-hidden="true">→</span></button>
        </form>
      </aside>
    </div>

    <div class="rd-list-head">
      <h2 class="rd-h">The full radar</h2>
      <p class="rd-sub">Same list, no flying. Sorted by votes.</p>
    </div>
    <ol class="rd-list" id="rd-list"></ol>

    <div class="rd-suggest" id="rd-suggest">
      <h2 class="rd-h">Missing something?</h2>
      <p class="rd-sub" id="rd-suggest-sub">Suggest a topic or a kind of person. The crew adds the good ones to the radar.</p>
      <form id="rd-suggest-form" hidden novalidate>
        <div class="rd-kind" role="radiogroup" aria-label="Type">
          <label class="lchip"><input type="radio" name="kind" value="topic" id="sg-topic" checked /><span>Topic</span></label>
          <label class="lchip"><input type="radio" name="kind" value="person" id="sg-person" /><span>Kind of person</span></label>
        </div>
        <label>Title<input id="sg-title" required minlength="3" maxlength="80" placeholder="Short and punchy" /></label>
        <label>One line about it <span class="opt">optional</span><input id="sg-desc" maxlength="300" /></label>
        <button class="pill pill-pink" type="submit">Suggest <span aria-hidden="true">→</span></button>
      </form>
      <a class="pill pill-ghost" id="rd-suggest-login" href="/login">Log in to suggest</a>
      <p class="rd-note" id="sg-note" role="status"></p>
    </div>
  </section>
</Club>

<style is:global>
  .rd-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 18px; }
  .rd-f { display: inline-flex; align-items: center; gap: 8px; font: 700 .9rem "Satoshi", system-ui, sans-serif; color: var(--bone); background: transparent; border: 1.5px solid rgba(237, 231, 220, .2); border-radius: 999px; padding: 9px 16px; cursor: pointer; }
  .rd-f[aria-pressed="true"] { background: var(--bone); color: var(--night); border-color: var(--bone); }
  .rd-f .dot { width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 0 1.5px rgba(237, 231, 220, .4); }
  .rd-sep { width: 1px; height: 24px; background: rgba(237, 231, 220, .2); margin-inline: 4px; }

  .rd-wrap { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); }
  .rd-stage { position: relative; overflow: hidden; border-radius: 28px; aspect-ratio: 16 / 9; min-height: 420px; max-width: 100%;
    background:
      radial-gradient(circle at 50% 50%, rgba(205, 220, 39, .08) 0 12%, transparent 12.2%),
      repeating-radial-gradient(circle at 50% 50%, transparent 0 9%, rgba(237, 231, 220, .06) 9% 9.25%),
      radial-gradient(ellipse at 50% 50%, #18241F 0%, var(--night) 75%);
    border: 1px solid rgba(237, 231, 220, .08); }
  .rd-stage::after { content: ""; position: absolute; left: 50%; top: 50%; width: 140%; aspect-ratio: 1; transform: translate(-50%, -50%); pointer-events: none;
    background: conic-gradient(from 0deg, rgba(205, 220, 39, .16), transparent 18%); border-radius: 50%; animation: sweep 6s linear infinite; }
  @keyframes sweep { to { transform: translate(-50%, -50%) rotate(360deg); } }
  .rd-center { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); margin: 0; font: 800 clamp(1.4rem, 4vw, 3rem)/.8 var(--f-display); letter-spacing: -.05em; color: var(--pink); opacity: .9; pointer-events: none; }
  .rd-center span { display: block; }
  .rd-loading { position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%); margin: 0; font: 500 .85rem var(--f-mono); color: var(--muted); }

  .rd-bug { position: absolute; left: 0; top: 0; display: grid; justify-items: center; gap: 4px; cursor: pointer; border: 0; padding: 0; background: none; color: inherit; will-change: transform; transition: opacity .3s; z-index: 2; }
  .rd-bug svg { display: block; width: var(--w, 70px); height: auto; transition: transform .2s; }
  .rd-bug:hover svg, .rd-bug:focus-visible svg { transform: scale(1.12) rotate(-6deg); }
  .rd-bug .lbl { max-width: 160px; text-align: center; font: 700 .72rem/1.15 "Satoshi", system-ui, sans-serif; color: var(--bone); background: rgba(11, 15, 13, .78); padding: 4px 9px; border-radius: 10px; }
  .rd-bug.person .lbl { border: 1.5px solid var(--pink); }
  .rd-bug.dim { opacity: .12; pointer-events: none; }
  .rd-bug.sel .lbl { background: var(--lime); color: var(--night); }

  .rd-card { position: absolute; right: 16px; top: 16px; bottom: 16px; width: min(380px, calc(100% - 32px)); overflow: auto; z-index: 10; background: var(--night-2); border: 1.5px solid rgba(237, 231, 220, .14); border-radius: 22px; padding: 22px; display: grid; gap: 10px; align-content: start; box-shadow: 0 30px 70px rgba(0, 0, 0, .5); }
  .rd-card[hidden] { display: none; }
  .rd-close { position: absolute; right: 12px; top: 10px; background: none; border: 0; color: var(--bone); font-size: 1.6rem; cursor: pointer; line-height: 1; }
  .rd-card-bug { width: 110px; border-radius: 18px; padding: 6px; }
  .rd-card-bug svg { display: block; width: 100%; height: auto; }
  .rd-meta { margin: 0; font: 500 .78rem var(--f-mono); color: var(--mint); letter-spacing: .06em; text-transform: uppercase; }
  .rd-card h2 { margin: 0; font: 800 1.7rem/1 var(--f-display); letter-spacing: -.03em; color: var(--bone); }
  .rd-desc { margin: 0; color: #C3CBC6; }
  .rd-votes { margin: 0; font: 500 .85rem var(--f-mono); color: var(--muted); }
  .rd-votes b { font: 800 1.6rem var(--f-display); color: var(--lime); }
  .rd-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .rd-actions .pill { padding: 10px 16px; font-size: .9rem; }
  #rd-vote[aria-pressed="true"] { background: var(--lime); }
  .rd-note { margin: 0; min-height: 1.1em; font: 500 .82rem var(--f-mono); color: var(--mint); }
  .rd-note a { color: var(--pink); }
  .rd-tip, #rd-suggest-form { display: grid; gap: 10px; }
  .rd-tip[hidden], #rd-suggest-form[hidden] { display: none; }
  .rd-tip-h { margin: 0; font-weight: 700; }
  .rd-tip label, #rd-suggest-form label:not(.lchip) { display: grid; gap: 6px; font-weight: 700; font-size: .88rem; }
  .rd-tip input:not([type=checkbox]), .rd-tip textarea, #rd-suggest-form input:not([type=radio]) { font: 500 .95rem "Satoshi", system-ui, sans-serif; color: var(--bone); background: var(--night); border: 1.5px solid rgba(237, 231, 220, .16); border-radius: 12px; padding: 10px 12px; width: 100%; }
  .rd-tip input:focus, .rd-tip textarea:focus, #rd-suggest-form input:focus { outline: none; border-color: var(--lime); }
  .rd-tip .f2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .rd-tip .check { display: flex !important; align-items: flex-start; gap: 8px; font-weight: 500 !important; color: #C3CBC6; }
  .rd-tip .check input { width: 16px; height: 16px; margin-top: 3px; accent-color: var(--lime); }
  .rd-tip .pill, #rd-suggest-form .pill { justify-self: start; }
  .opt { font: 500 .72rem var(--f-mono); color: var(--muted); margin-left: 4px; }
  .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .rd-list-head, .rd-suggest { margin-top: clamp(40px, 6vw, 72px); display: grid; gap: 8px; }
  .rd-h { margin: 0; font: 800 clamp(1.7rem, 3vw, 2.3rem)/1 var(--f-display); letter-spacing: -.03em; }
  .rd-sub { margin: 0; color: var(--muted); }
  .rd-list { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; }
  .rd-row { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 12px 16px; border-radius: 16px; background: var(--night-2); border: 1px solid rgba(237, 231, 220, .06); }
  .rd-row .pdot { width: 12px; height: 12px; border-radius: 50%; }
  .rd-row b { display: block; }
  .rd-row small { font: 500 .78rem var(--f-mono); color: var(--muted); }
  .rd-row button { font: 700 .85rem "Satoshi", system-ui, sans-serif; color: var(--bone); background: transparent; border: 1.5px solid rgba(237, 231, 220, .2); border-radius: 999px; padding: 7px 14px; cursor: pointer; white-space: nowrap; }
  .rd-row button[aria-pressed="true"] { background: var(--lime); color: var(--night); border-color: var(--lime); }
  .rd-row[hidden] { display: none; }
  .rd-suggest form { max-width: 560px; margin-top: 8px; }
  .rd-kind { display: flex; gap: 8px; }
  .rd-kind .lchip input { position: absolute; opacity: 0; }
  .rd-kind .lchip span { display: inline-flex; padding: 8px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px rgba(237, 231, 220, .2); cursor: pointer; font-weight: 500; }
  .rd-kind .lchip input:checked + span { background: var(--pink); color: var(--night); box-shadow: none; }
  #rd-suggest-login { justify-self: start; margin-top: 8px; }

  @media (max-width: 760px) {
    .rd-stage { aspect-ratio: 3 / 4; min-height: 0; }
    .rd-card { position: static; width: 100%; margin-top: 14px; box-shadow: none; }
    .rd-bug .lbl { max-width: 110px; font-size: .64rem; }
  }
  @media (prefers-reduced-motion: reduce) { .rd-stage::after { animation: none; } }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { bugSVG, OPTS } from '../lib/bug/render.js';
  import { hash } from '../lib/bug/card';
  import { track } from '../lib/track';

  type Topic = { id: string; kind: 'topic' | 'person'; pillar: 'bugs' | 'rebels' | 'lunapark'; category: string | null; title: string; description: string | null; votes: number; voted: boolean };
  type Flyer = { t: Topic; el: HTMLButtonElement; x: number; y: number; vx: number; vy: number; w: number; hidden: boolean };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const stage = $('rd-stage');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SHELL = { bugs: 'purple', rebels: 'green', lunapark: 'lime' } as const;
  const PILLAR_COLOR = { bugs: 'var(--purple)', rebels: 'var(--green)', lunapark: 'var(--lime)' } as const;
  const PILLAR_NAME = { bugs: 'Bugs', rebels: 'Rebels', lunapark: 'Lunapark' } as const;
  const TILE = { bugs: 'var(--mint)', rebels: 'var(--pink)', lunapark: 'var(--purple)' } as const;

  let topics: Topic[] = [];
  let flyers: Flyer[] = [];
  let userId: string | null = null;
  let current: Topic | null = null;
  let filter = 'all';

  // a stable, unique-looking bug per topic
  function bugFor(t: Topic) {
    const h = hash(t.id);
    const pick = (k: string, salt: number) => { const items = OPTS[k].items; return items[(h >>> salt) % items.length][0]; };
    return {
      role: 'curious', shape: pick('shape', 1), pose: pick('pose', 3), attitude: pick('attitude', 5), pattern: pick('pattern', 7),
      eyes: pick('eyes', 9), mouth: pick('mouth', 11), antennae: pick('antennae', 13), hat: (h >>> 15) % 3 === 0 ? pick('hat', 17) : 'none',
      shell: t.kind === 'person' ? 'pink' : SHELL[t.pillar], accent: 'auto',
    };
  }

  const width = (t: Topic) => {
    const base = innerWidth < 760 ? 46 : 64;
    return Math.min(base + t.votes * 8, base * 2.2);
  };

  function build() {
    for (const f of flyers) f.el.remove();
    const W = stage.clientWidth, H = stage.clientHeight;
    flyers = topics.map((t, i) => {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = `rd-bug ${t.kind}`;
      el.innerHTML = bugSVG(bugFor(t), 120);
      const lbl = document.createElement('span');
      lbl.className = 'lbl';
      lbl.textContent = t.title; // text only
      el.appendChild(lbl);
      const w = width(t);
      el.style.setProperty('--w', `${w}px`);
      el.setAttribute('aria-label', `${t.title}. ${t.votes} votes`);
      el.addEventListener('click', () => open(t));
      stage.appendChild(el);
      const a = (i / topics.length) * Math.PI * 2;
      const r = 0.25 + ((hash(t.id) % 100) / 100) * 0.2;
      return { t, el, w, hidden: false, x: W / 2 + Math.cos(a) * W * r, y: H / 2 + Math.sin(a) * H * r, vx: (Math.random() - 0.5) * 0.6, vy: (Math.random() - 0.5) * 0.6 };
    });
    $('rd-loading').hidden = true;
    applyFilter();
    place();
  }

  function place() {
    for (const f of flyers) {
      const box = f.el.getBoundingClientRect();
      f.el.style.transform = `translate(${(f.x - box.width / 2).toFixed(1)}px, ${(f.y - f.w / 2).toFixed(1)}px)`;
    }
  }

  let last = 0;
  function tick(ts: number) {
    requestAnimationFrame(tick);
    const dt = last ? Math.min((ts - last) / 16.7, 3) : 1;
    last = ts;
    if (reduce || document.hidden) return;
    const r = stage.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return;
    const W = stage.clientWidth, H = stage.clientHeight, cx = W / 2, cy = H / 2;
    const maxVotes = Math.max(1, ...topics.map((t) => t.votes));
    for (const f of flyers) {
      if (f.hidden || f.el.matches(':hover') || f.t === current) continue;
      // wander
      f.vx += (Math.random() - 0.5) * 0.08 * dt;
      f.vy += (Math.random() - 0.5) * 0.08 * dt;
      // popular bugs drift toward the center, but never onto the logo
      const pull = 0.00006 + (f.t.votes / maxVotes) * 0.00025;
      const dx = cx - f.x, dy = cy - f.y, d = Math.hypot(dx, dy) || 1;
      const keep = Math.min(W, H) * 0.16;
      const toward = d > keep ? pull : -0.0012;
      f.vx += dx * toward * dt; f.vy += dy * toward * dt;
      // keep some distance from each other
      for (const o of flyers) {
        if (o === f || o.hidden) continue;
        const ex = f.x - o.x, ey = f.y - o.y, e2 = ex * ex + ey * ey, min = (f.w + o.w) * 0.75;
        if (e2 < min * min && e2 > 0.01) { const e = Math.sqrt(e2); f.vx += (ex / e) * 0.05 * dt; f.vy += (ey / e) * 0.05 * dt; }
      }
      // walls
      const m = f.w * 0.7;
      if (f.x < m) f.vx += 0.12 * dt; if (f.x > W - m) f.vx -= 0.12 * dt;
      if (f.y < m) f.vy += 0.12 * dt; if (f.y > H - m - 20) f.vy -= 0.12 * dt;
      const sp = Math.hypot(f.vx, f.vy), max = 0.9;
      if (sp > max) { f.vx = (f.vx / sp) * max; f.vy = (f.vy / sp) * max; }
      f.vx *= 0.985; f.vy *= 0.985;
      f.x += f.vx * dt; f.y += f.vy * dt;
    }
    place();
  }

  function applyFilter() {
    const show = (t: Topic) => filter === 'all' || t.kind === filter || t.pillar === filter;
    for (const f of flyers) { f.hidden = !show(f.t); f.el.classList.toggle('dim', f.hidden); }
    document.querySelectorAll<HTMLElement>('.rd-row').forEach((row) => {
      const t = topics.find((x) => x.id === row.dataset.id);
      row.hidden = !!t && !show(t);
    });
  }

  function renderList() {
    const list = $('rd-list');
    list.replaceChildren();
    for (const t of [...topics].sort((a, b) => b.votes - a.votes)) {
      const li = document.createElement('li');
      li.className = 'rd-row';
      li.dataset.id = t.id;
      const dot = document.createElement('i');
      dot.className = 'pdot';
      dot.style.background = t.kind === 'person' ? 'var(--pink)' : PILLAR_COLOR[t.pillar];
      const txt = document.createElement('div');
      const b = document.createElement('b'); b.textContent = t.title;
      const s = document.createElement('small'); s.textContent = `${t.kind === 'person' ? 'Person' : PILLAR_NAME[t.pillar]} · ${t.votes} ${t.votes === 1 ? 'vote' : 'votes'}`;
      txt.append(b, s);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = t.voted ? 'Voted ✓' : 'I want this';
      btn.setAttribute('aria-pressed', String(t.voted));
      btn.addEventListener('click', () => vote(t));
      li.append(dot, txt, btn);
      list.appendChild(li);
    }
    applyFilter();
  }

  function open(t: Topic) {
    current = t;
    flyers.forEach((f) => f.el.classList.toggle('sel', f.t === t));
    const bug = $('rd-card-bug');
    bug.style.background = TILE[t.pillar];
    bug.innerHTML = bugSVG(bugFor(t), 110);
    $('rd-meta').textContent = `${t.kind === 'person' ? 'Kind of person' : 'Topic'} · ${PILLAR_NAME[t.pillar]}${t.category && t.category !== 'People' ? ' · ' + t.category : ''}`;
    $('rd-title').textContent = t.title;
    $('rd-desc').textContent = t.description ?? '';
    updateVotes();
    $('rd-note').textContent = '';
    $('rd-tip').hidden = true;
    $('rd-card').hidden = false;
    track('radar_open', t.title);
  }

  function updateVotes() {
    if (!current) return;
    $('rd-votes').textContent = String(current.votes);
    $('rd-votes-label').textContent = current.votes === 1 ? 'vote' : 'votes';
    const v = $('rd-vote');
    v.setAttribute('aria-pressed', String(current.voted));
    v.textContent = current.voted ? 'Voted ✓' : 'I want this';
  }

  async function vote(t: Topic) {
    if (!supabase) return;
    if (!userId) {
      if (current !== t) open(t);
      $('rd-note').innerHTML = '';
      const msg = document.createElement('span');
      msg.textContent = 'Votes are for members. ';
      const a = document.createElement('a'); a.href = '/lab'; a.textContent = 'Build your bug';
      const b = document.createElement('a'); b.href = '/login'; b.textContent = 'log in';
      $('rd-note').append(msg, a, document.createTextNode(' or '), b, document.createTextNode('.'));
      return;
    }
    const was = t.voted;
    t.voted = !was; t.votes += was ? -1 : 1;
    updateVotes(); renderList(); resize(t);
    const res = was
      ? await supabase.from('topic_votes').delete().eq('topic_id', t.id).eq('user_id', userId)
      : await supabase.from('topic_votes').insert({ topic_id: t.id });
    if (res.error) {
      t.voted = was; t.votes += was ? 1 : -1;
      updateVotes(); renderList(); resize(t);
      $('rd-note').textContent = 'That did not work. Try again.';
      return;
    }
    track(was ? 'radar_unvote' : 'radar_vote', t.title);
  }

  function resize(t: Topic) {
    const f = flyers.find((x) => x.t === t);
    if (!f) return;
    f.w = width(t);
    f.el.style.setProperty('--w', `${f.w}px`);
    f.el.setAttribute('aria-label', `${t.title}. ${t.votes} votes`);
  }

  // ---- card actions ----
  $('rd-close').addEventListener('click', () => { $('rd-card').hidden = true; current = null; flyers.forEach((f) => f.el.classList.remove('sel')); });
  $('rd-vote').addEventListener('click', () => { if (current) vote(current); });
  $('rd-tip-open').addEventListener('click', () => { $('rd-tip').hidden = false; $('tip-who').focus(); track('radar_tip_open', current?.title); });

  $('rd-tip').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const get = (id: string) => ($(id) as HTMLInputElement).value.trim();
    const bad = [...form.querySelectorAll<HTMLInputElement>('input:not([name="website"]), textarea')].find((el) => !el.checkValidity());
    if (bad) { $('rd-note').textContent = 'Please fill in who, your name, a valid email and tick the box.'; bad.focus(); return; }
    if ((form.elements.namedItem('website') as HTMLInputElement).value) { form.hidden = true; $('rd-note').textContent = 'Thanks for the tip.'; return; }
    if (!supabase || !current) return;
    const link = get('tip-link');
    const { error } = await supabase.from('submissions').insert({
      kind: 'guest_tip', consent: true,
      name: get('tip-name').slice(0, 80), email: get('tip-email').slice(0, 120),
      topic: current.title.slice(0, 120),
      details: `${get('tip-who')}${get('tip-why') ? ' · ' + get('tip-why') : ''}`.slice(0, 800),
      link: /^https?:\/\//i.test(link) ? link.slice(0, 300) : null,
    });
    if (error) { $('rd-note').textContent = 'Sending failed. Try again in a moment.'; console.error(error); return; }
    form.reset(); form.hidden = true;
    $('rd-note').textContent = 'Thanks for the tip. The crew will take it from here.';
    track('radar_tip', current.title);
  });

  // ---- filters ----
  document.querySelectorAll<HTMLButtonElement>('.rd-f').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.f!;
    document.querySelectorAll('.rd-f').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    applyFilter();
  }));

  // ---- suggest ----
  $('rd-suggest-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const title = ($('sg-title') as HTMLInputElement).value.replace(/\s+/g, ' ').trim();
    if (title.length < 3) { $('sg-note').textContent = 'Give it a title (at least 3 characters).'; return; }
    if (!supabase || !userId) return;
    const kind = (document.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value ?? 'topic') as 'topic' | 'person';
    const description = ($('sg-desc') as HTMLInputElement).value.trim().slice(0, 300) || null;
    const { error } = await supabase.from('topics').insert({ title: title.slice(0, 80), description, kind, pillar: 'rebels' });
    if (error) { $('sg-note').textContent = 'Sending failed. Try again in a moment.'; console.error(error); return; }
    (e.currentTarget as HTMLFormElement).reset();
    $('sg-note').textContent = 'Thanks. The crew will review it and add it to the radar.';
    track('radar_suggest', kind);
  });

  // ---- start ----
  async function start() {
    if (!supabase) { $('rd-loading').textContent = 'The radar is not connected on this site yet.'; return; }
    const { data: s } = await supabase.auth.getSession();
    if (s.session) {
      userId = s.session.user.id;
      $('rd-suggest-form').hidden = false;
      $('rd-suggest-login').hidden = true;
      $('tip-email') && (($('tip-email') as HTMLInputElement).value = s.session.user.email ?? '');
    }
    const { data, error } = await supabase.rpc('radar_topics');
    if (error) { $('rd-loading').textContent = 'Could not load the radar. Try again in a moment.'; return; }
    topics = ((data ?? []) as Topic[]).map((t) => ({ ...t, votes: Number(t.votes) }));
    if (!topics.length) { $('rd-loading').textContent = 'Nothing on the radar yet.'; return; }
    build();
    renderList();
    requestAnimationFrame(tick);
  }
  addEventListener('resize', () => { if (topics.length) build(); });
  start();
</script>
