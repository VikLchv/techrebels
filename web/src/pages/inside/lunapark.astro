<script>
  import { supabase } from '../../lib/supabase';
  import { bugSVG } from '../../lib/bug/render.js';
  import { createBugRush } from '../../lib/arcade/bugRush';
  type BoardRow={rank:number;score:number;is_me:boolean;bug_number:number;bug_name:string;bug_config:Record<string,unknown>};
  let game:ReturnType<typeof createBugRush>|null=null;let period='week';let saving=false;let openingTimer=0;
  const $=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
  const format=(value:number)=>value.toLocaleString('en-US');
  function closeOpening(){window.clearTimeout(openingTimer);const opening=document.getElementById('park-opening');if(opening)opening.hidden=true;}
  function playOpening(){const opening=document.getElementById('park-opening');if(!opening)return;if(matchMedia('(prefers-reduced-motion: reduce)').matches){opening.hidden=true;return;}opening.hidden=false;opening.classList.remove('go');void opening.offsetWidth;opening.classList.add('go');openingTimer=window.setTimeout(closeOpening,3150);$('opening-skip').addEventListener('click',closeOpening,{once:true});}
  function openGame(){const modal=$('game-modal');modal.hidden=false;document.body.classList.add('game-open');requestAnimationFrame(()=>$<HTMLButtonElement>('game-start').focus());}
  function closeGame(force=false){const modal=document.getElementById('game-modal');if(!modal){document.body.classList.remove('game-open');return;}if(!force&&game?.isRunning()&&!confirm('Leave this run? The current score will not be saved.'))return;game?.stop();modal.hidden=true;$('game-result').hidden=true;$('game-intro').hidden=false;document.body.classList.remove('game-open');$<HTMLButtonElement>('open-bug-rush')?.focus();}
  function rankRow(row:BoardRow){const li=document.createElement('li');li.className=`rank-item${row.is_me?' me':''}`;const rank=document.createElement('span');rank.className='rank-number';rank.textContent=`#${row.rank}`;const avatar=document.createElement('span');avatar.className='rank-bug';avatar.innerHTML=bugSVG(row.bug_config,60);const copy=document.createElement('span');copy.className='rank-copy';const name=document.createElement('b');name.textContent=row.bug_name;const id=document.createElement('span');id.textContent=`BUG-${String(row.bug_number).padStart(4,'0')}${row.is_me?' · YOU':''}`;copy.append(name,id);const score=document.createElement('b');score.className='rank-score';score.textContent=format(row.score);li.append(rank,avatar,copy,score);return li;}
  async function loadBoard(){if(!supabase)return;const note=$('leaderboard-note');note.textContent='Loading the damage report…';const {data,error}=await supabase.rpc('get_arcade_leaderboard',{p_game:'bug_rush',p_period:period,p_limit:20});if(error){note.textContent='Leaderboard unlocks after the Lunapark SQL is installed.';return;}const board=(data??{}) as {leaders?:BoardRow[];me?:{rank:number;score:number}|null};const list=$<HTMLOListElement>('rank-list');list.replaceChildren(...(board.leaders?.length?board.leaders.map(rankRow):[Object.assign(document.createElement('li'),{className:'rank-empty',textContent:'No scores yet. The throne is unattended.'})]));$('my-rank').innerHTML=board.me?`<span>Your position</span><b>#${board.me.rank} · ${format(board.me.score)} points</b>`:'<span>Your position</span><b>Unranked — go cause trouble.</b>';note.textContent='Only bug identities appear here. Human names stay backstage.';}
  async function saveScore(score:number,durationMs:number){if(!supabase||saving)return;saving=true;$('save-status').textContent='Saving damage…';const {error}=await supabase.rpc('submit_arcade_score',{p_game:'bug_rush',p_score:score,p_duration_ms:durationMs,p_client_run_id:crypto.randomUUID()});saving=false;$('save-status').textContent=error?'Score stayed local — install the Lunapark SQL.':'Saved to the Hall of Infamy ✓';if(!error)await loadBoard();}
  async function startPage(){if(!supabase){$('page-loading').hidden=true;$('page-out').hidden=false;return;}const {data:session}=await supabase.auth.getSession();const user=session.session?.user;if(!user){$('page-loading').hidden=true;$('page-out').hidden=false;return;}const {data:bug}=await supabase.from('bugs').select('bug_number,name,config').eq('user_id',user.id).maybeSingle();$('page-loading').hidden=true;$('page-app').hidden=false;if(!bug){$('game-intro').innerHTML='<p class="eyebrow">Bug required</p><h3>Build your bug before entering.</h3><p>Your bug is your player, identity and ticket.</p><a class="pill pill-pink" href="/lab">Build my bug →</a>';await loadBoard();return;}$('ticket-bug').textContent=`BUG-${String(bug.bug_number).padStart(4,'0')}`;$('player-bug-name').textContent=bug.name;game=createBugRush($<HTMLCanvasElement>('bug-rush'),bugSVG(bug.config,160),{onTick:({score,combo,lives})=>{$('game-score').textContent=String(score).padStart(5,'0');$('game-combo').textContent=`×${combo}`;$('game-lives').textContent=`${'♥ '.repeat(lives)}${'♡ '.repeat(3-lives)}`.trim();$('game-lives').setAttribute('aria-label',`${lives} lives`);},onEnd:({score,durationMs})=>{$('result-score').textContent=`${format(score)} points of chaos.`;$('result-copy').textContent=score>=10000?'Absolutely irresponsible. We are impressed.':score>=4000?'A respectable amount of damage.':'Your bug is warming up. The meetings won this round.';$('game-result').hidden=false;saveScore(score,durationMs);}});await loadBoard();}
  function play(){if(!game||game.isRunning())return;$('game-intro').hidden=true;$('game-result').hidden=true;$('save-status').textContent='';game.start();}
  function setupLunapark(){if(!document.querySelector('.lunapark-page'))return;game?.destroy();game=null;playOpening();$('open-bug-rush').addEventListener('click',openGame);$('game-close').addEventListener('click',()=>closeGame());$('game-start').addEventListener('click',play);$('game-again').addEventListener('click',play);$('game-fire').addEventListener('pointerdown',(event)=>{event.preventDefault();game?.fire();});document.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(button=>button.addEventListener('click',()=>{period=button.dataset.period??'week';document.querySelectorAll('[data-period]').forEach(item=>item.classList.toggle('active',item===button));loadBoard();}));startPage();}
  document.addEventListener('keydown',(event)=>{const modal=document.getElementById('game-modal');if(event.key==='Escape'&&modal&&!modal.hidden)closeGame();});document.addEventListener('astro:page-load',setupLunapark);document.addEventListener('astro:before-swap',()=>{closeOpening();closeGame(true);game?.destroy();game=null;});
</script>
