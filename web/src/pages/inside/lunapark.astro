---
import Club from '../../layouts/Club.astro';
import '../../styles/inside-pages.css';
---
<Club title="Lunapark · Inside · techRebels" description="Play Bug Rush and climb the techRebels Hall of Infamy.">
  <section class="block first inside-page lunapark-page">
    <div class="park-opening" id="park-opening" aria-label="Entering the techRebels Lunapark">
      <div class="opening-curtain opening-left"></div><div class="opening-curtain opening-right"></div>
      <div class="opening-wheel" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="opening-chaos" aria-hidden="true"><span>✦</span><span>BUGS</span><span>★</span><span>CHAOS</span><span>✦</span></div>
      <div class="opening-copy"><span>HOLD ON TO YOUR BUG</span><strong>WELCOME TO<br />LUNAPARK</strong><em>STATUS: DEFINITELY NOT SAFE</em></div>
      <button type="button" id="opening-skip">Skip the ride →</button>
    </div>
    <div class="page-loading" id="page-loading"><p class="eyebrow">Inside · Lunapark</p><h1 class="h2">Waking the machines…</h1></div>
    <div class="page-out ticket-booth" id="page-out" hidden><div class="booth-lights" aria-hidden="true"></div><p class="eyebrow">Lunapark ticket booth</p><h1 class="h2">Ticket holders only.</h1><p class="lede">One bug per rider. Log in to enter the park.</p><a class="pill pill-lime" href="/login?next=%2Finside%2Flunapark">Show my ticket →</a><span class="booth-small">No refunds. No responsible adults.</span></div>
    <div id="page-app" hidden>
      <header class="park-entrance">
        <div class="side-attraction ferris-attraction" aria-hidden="true"><div class="ferris-wheel"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="ferris-legs"></div></div>
        <div class="side-attraction swing-attraction" aria-hidden="true"><div class="swing-top"></div><div class="swing-pole"></div><i></i><i></i><i></i><i></i><i></i></div>
        <svg class="coaster" viewBox="0 0 1600 230" preserveAspectRatio="none" aria-hidden="true"><path d="M0 190 C170 190 170 28 340 28 S510 206 690 145 S850 20 970 88 S1110 210 1250 74 S1450 26 1600 105"/><path class="coaster-rails" d="M0 190 C170 190 170 28 340 28 S510 206 690 145 S850 20 970 88 S1110 210 1250 74 S1450 26 1600 105"/></svg>
        <div class="entrance-stars" aria-hidden="true">✦　★　✦</div>
        <p class="entrance-kicker">techRebels proudly regrets to present</p>
        <div class="entrance-sign"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><span>WELCOME TO THE</span><h1>LUNAPARK</h1><p>A highly unproductive part of techRebels.</p></div>
        <div class="entrance-bottom"><p>Collect signals. Patch evil bugs. Dodge corporate nonsense.</p><div class="ticket"><span>ADMIT ONE</span><b id="ticket-bug">BUG—</b></div></div>
      </header>
      <div class="park-strip" aria-label="Park status"><span><i></i> BUG RUSH · OPEN</span><span>3 LIVES · NO TIME LIMIT</span><span>HALL OF INFAMY · LIVE</span></div>

      <section class="attraction-lobby">
        <div class="lobby-head"><p class="eyebrow">Pick your poison</p><h2>Choose an attraction.</h2><p>More terrible ideas are currently being assembled behind the fence.</p></div>
        <div class="attraction-grid">
          <button class="attraction-card available" id="open-bug-rush" type="button"><span class="ride-icon rush-icon" aria-hidden="true"><i></i><i></i><i></i><b>BUG</b></span><span class="ride-status">Open now</span><strong>Bug Rush</strong><small>Collect signals. Patch evil bugs. Keep all three lives.</small><em>Play →</em></button>
          <article class="attraction-card soon"><span class="ride-icon fix-icon" aria-hidden="true"><b>FIX</b><i>/</i><b>NOPE</b></span><span class="ride-status">Coming soon</span><strong>Fix or Won’t Fix</strong><small>Make terrible decisions under unreasonable pressure.</small><em>Under construction</em></article>
          <article class="attraction-card soon"><span class="ride-icon swarm-icon" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span class="ride-status">Coming soon</span><strong>Swarm Rescue</strong><small>Connect the right bugs before the whole swarm glitches.</small><em>Under construction</em></article>
        </div>
      </section>

      <div class="lobby-lower">
        <aside class="leaderboard page-panel">
          <div><p class="eyebrow">Hall of Infamy</p><h2 class="section-title">This week’s chaos.</h2></div>
          <div class="period-tabs" role="tablist" aria-label="Leaderboard period"><button type="button" data-period="today">Today</button><button type="button" data-period="week" class="active">This week</button><button type="button" data-period="all">All time</button></div>
          <div class="my-rank" id="my-rank"><span>Your position</span><b>Unranked — go cause trouble.</b></div>
          <ol class="rank-list" id="rank-list"><li class="rank-empty">No scores yet. The throne is unattended.</li></ol>
          <p class="leaderboard-note" id="leaderboard-note">Only bug identities appear here. Human names stay backstage.</p>
        </aside>
        <div class="park-poster"><span>TONIGHT</span><strong>ONE BUG<br />LEAVES<br />A LEGEND</strong><small>Probably. Terms and conditions apply.</small></div>
      </div>

      <div class="game-modal" id="game-modal" hidden role="dialog" aria-modal="true" aria-labelledby="game-modal-title">
        <div class="game-modal-shell">
          <button class="game-close" id="game-close" type="button" aria-label="Close Bug Rush">×</button>
          <section class="game-machine">
            <div class="marquee"><span>NOW PLAYING</span><h2 id="game-modal-title">BUG RUSH</h2><p>Play stupid games. Win eternal bug glory.</p></div>
            <div class="game-hud" aria-live="polite"><div><span>Score</span><b id="game-score">00000</b></div><div><span>Combo</span><b id="game-combo">×1</b></div><div><span>Lives</span><b id="game-lives" aria-label="3 lives">♥ ♥ ♥</b></div></div>
            <div class="game-stage" id="game-stage">
              <canvas id="bug-rush" aria-label="Bug Rush game area"></canvas>
              <div class="game-overlay" id="game-intro"><p class="eyebrow">Your next bad decision</p><h3>Ready, <span id="player-bug-name">rebel</span>?</h3><p>Catch <b class="lime">green signals</b>. Patch <b class="mint">evil bugs</b>. Avoid <b class="pink">corporate nonsense</b>.</p><button class="pill pill-pink" id="game-start" type="button">Release my bug →</button></div>
              <div class="game-overlay result" id="game-result" hidden><p class="eyebrow">Damage report</p><h3 id="result-score">0 points</h3><p id="result-copy">Your bug caused a respectable amount of chaos.</p><div class="result-actions"><button class="pill pill-pink" id="game-again" type="button">Cause more chaos</button><span id="save-status" role="status"></span></div></div>
              <button class="fire-button" id="game-fire" type="button" aria-label="Fire a patch at the nearest evil bug">PATCH!</button>
            </div>
            <div class="controls"><span><kbd>WASD</kbd> or <kbd>↑↓←→</kbd></span><span><kbd>SPACE</kbd> or click to fire</span><span>Drag + PATCH on mobile</span></div>
          </section>
        </div>
      </div>
    </div>
  </section>
</Club>

<style is:global>
  .club main:has(.park-opening:not([hidden])){z-index:600}.club main:has(.game-modal:not([hidden])){z-index:500}
  .park-opening{display:none}.js .park-opening{position:fixed;inset:0;z-index:500;display:grid;place-items:center;overflow:hidden;background:#0A0613;color: var(--fg);isolation:isolate}.park-opening[hidden]{display:none}.opening-curtain{position:absolute;inset-block:0;width:52%;z-index:4;background:repeating-linear-gradient(90deg,#342450 0 8%,#4A2760 8% 16%);box-shadow:inset 0 0 80px rgba(0,0,0,.55)}.opening-left{left:0;transform-origin:left}.opening-right{right:0;transform-origin:right}.park-opening.go .opening-left{animation:curtain-left 2.2s .65s cubic-bezier(.75,0,.2,1) forwards}.park-opening.go .opening-right{animation:curtain-right 2.2s .65s cubic-bezier(.75,0,.2,1) forwards}.opening-copy{position:relative;z-index:5;display:grid;justify-items:center;gap:12px;text-align:center;animation:opening-copy 2.85s ease both}.opening-copy span{color: var(--lime-text);font:900 clamp(.65rem,1.3vw,.9rem) var(--f-mono);letter-spacing:.24em}.opening-copy strong{color: var(--pink-text);font:950 clamp(4rem,13vw,11rem)/.75 var(--f-display);letter-spacing:-.075em;text-shadow:5px 7px 0 #2A1416,0 0 35px rgba(244,165,212,.48)}.opening-copy em{color: var(--mint-text);font:800 clamp(.62rem,1.2vw,.82rem) var(--f-mono);font-style:normal;letter-spacing:.14em}.opening-wheel{position:absolute;z-index:2;left:-8vw;bottom:-22vw;width:58vw;aspect-ratio:1;border:7px solid var(--pink);border-radius:50%;opacity:.42;background:repeating-conic-gradient(from 0deg,var(--pink) 0 1deg,transparent 1deg 30deg);box-shadow:0 0 45px var(--purple),inset 0 0 45px rgba(244,165,212,.2);animation:wheel-spin 8s linear infinite}.opening-wheel:after{content:"";position:absolute;inset:44%;border-radius:50%;background:var(--lime);box-shadow:0 0 30px var(--lime)}.opening-wheel i{position:absolute;left:48%;top:-12px;width:4%;height:24px;border-radius:6px;background:var(--pink);transform-origin:50% calc(29vw + 12px)}.opening-wheel i:nth-child(2){transform:rotate(45deg)}.opening-wheel i:nth-child(3){transform:rotate(90deg)}.opening-wheel i:nth-child(4){transform:rotate(135deg)}.opening-wheel i:nth-child(5){transform:rotate(180deg)}.opening-wheel i:nth-child(6){transform:rotate(225deg)}.opening-wheel i:nth-child(7){transform:rotate(270deg)}.opening-wheel i:nth-child(8){transform:rotate(315deg)}.opening-chaos{position:absolute;z-index:3;inset:0}.opening-chaos span{position:absolute;color: var(--lime-text);font:900 clamp(1rem,3vw,2.5rem) var(--f-mono);animation:chaos-fly 2.8s ease-in-out both}.opening-chaos span:nth-child(1){left:12%;top:16%}.opening-chaos span:nth-child(2){right:8%;top:19%;color: var(--pink-text);transform:rotate(13deg)}.opening-chaos span:nth-child(3){right:17%;bottom:17%}.opening-chaos span:nth-child(4){left:8%;bottom:12%;color: var(--mint-text);transform:rotate(-11deg)}.opening-chaos span:nth-child(5){left:50%;top:7%}.park-opening button{position:absolute;right:20px;bottom:20px;z-index:8;padding:9px 13px;border:1px solid rgba(var(--fg-rgb), .28);border-radius:999px;background:rgba(var(--bg-rgb), .55);color: var(--fg);font:700 .7rem var(--f-mono);cursor:pointer}
  @keyframes curtain-left{to{transform:translateX(-105%) rotate(-5deg)}}@keyframes curtain-right{to{transform:translateX(105%) rotate(5deg)}}@keyframes opening-copy{0%{opacity:0;transform:scale(.2) rotate(-7deg)}18%{opacity:1;transform:scale(1.12) rotate(2deg)}30%,68%{transform:scale(1) rotate(0)}88%{opacity:1;transform:scale(1.65)}100%{opacity:0;transform:scale(4)}}@keyframes chaos-fly{0%{opacity:0;transform:translateY(60px) rotate(-20deg)}30%,70%{opacity:1}100%{opacity:0;transform:translateY(-120px) rotate(25deg)}}@keyframes wheel-spin{to{transform:rotate(360deg)}}
  .club main:has(.lunapark-page){background:
    radial-gradient(circle at 8% 12%,rgba(244,165,212,.2),transparent 22rem),
    radial-gradient(circle at 92% 22%,rgba(205,220,39,.14),transparent 25rem),
    linear-gradient(180deg,#241735 0,#0b0f0d 760px);}
  .club main>.lunapark-page{width:100%;max-width:none;margin:0;padding-inline:clamp(16px,4vw,58px);position:relative;overflow:hidden;}
  .club main>.lunapark-page:before{content:"";position:absolute;z-index:0;inset:0 0 auto;height:210px;pointer-events:none;opacity:.16;background:repeating-conic-gradient(from -20deg at 50% -80%,var(--pink) 0 8deg,transparent 8deg 16deg);mask-image:linear-gradient(#000,transparent)}
  .lunapark-page>#page-app,.lunapark-page>.page-loading,.lunapark-page>.page-out{position:relative;z-index:1;max-width:1400px;margin-inline:auto}
  .park-entrance{display:grid;justify-items:center;gap:12px;margin:0 auto 25px;text-align:center}.entrance-stars{color: var(--lime-text);font-size:clamp(1.2rem,3vw,2rem);letter-spacing:.22em;animation:park-stars 1.8s ease-in-out infinite}.entrance-kicker{margin:0;color: var(--pink-text);font:800 .72rem var(--f-mono);letter-spacing:.17em;text-transform:uppercase}.entrance-sign{position:relative;min-width:min(820px,94vw);padding:28px clamp(25px,6vw,74px) 24px;border:8px solid #F4A5D4;border-radius:46px 46px 22px 22px;background:#342450;color: var(--fg);box-shadow:0 0 0 5px #2A1416,0 18px 0 #2A1416,0 30px 70px rgba(0,0,0,.38);transform:perspective(700px) rotateX(-2deg)}.entrance-sign:before,.entrance-sign:after{content:"";position:absolute;bottom:-37px;width:18px;height:42px;background:#2A1416}.entrance-sign:before{left:13%}.entrance-sign:after{right:13%}.entrance-sign>span{color: var(--lime-text);font:900 .78rem var(--f-mono);letter-spacing:.25em}.entrance-sign h1{margin:4px 0 0;color: var(--pink-text);font:950 clamp(4rem,12vw,9rem)/.76 var(--f-display);letter-spacing:-.075em;text-shadow:4px 5px 0 #2A1416}.entrance-sign p{margin:13px 0 0;color:#D8CEE0;font-weight:750}.entrance-sign i{position:absolute;top:-17px;width:15px;height:15px;border:3px solid #2A1416;border-radius:50%;background:var(--lime);box-shadow:0 0 16px var(--lime);animation:park-bulb 1.2s steps(2) infinite}.entrance-sign i:nth-child(1){left:7%}.entrance-sign i:nth-child(2){left:19%;animation-delay:.15s}.entrance-sign i:nth-child(3){left:31%;animation-delay:.3s}.entrance-sign i:nth-child(4){left:43%;animation-delay:.45s}.entrance-sign i:nth-child(5){left:55%;animation-delay:.6s}.entrance-sign i:nth-child(6){left:67%;animation-delay:.75s}.entrance-sign i:nth-child(7){left:79%;animation-delay:.9s}.entrance-sign i:nth-child(8){left:91%;animation-delay:1.05s}.entrance-bottom{display:flex;align-items:center;justify-content:center;gap:28px;margin-top:20px}.entrance-bottom>p{max-width:520px;margin:0;color:#D8CEE0;font-weight:700}.park-strip{display:flex;justify-content:space-around;gap:24px;margin:0 0 16px;padding:10px 18px;overflow:hidden;border:2px solid #2A1416;border-radius:12px;background:repeating-linear-gradient(-45deg,#CDDC27 0 16px,#B8C71F 16px 32px);color:#0B0F0D;box-shadow:0 5px 0 #2A1416;font:900 .69rem var(--f-mono);letter-spacing:.06em;white-space:nowrap}.park-strip i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#7A304F;box-shadow:0 0 0 3px rgba(122,48,79,.22);animation:live 1s infinite}.ticket-booth{justify-items:center!important;max-width:720px!important;margin:clamp(30px,7vw,100px) auto!important;padding:clamp(34px,6vw,70px)!important;border:8px solid var(--pink);border-radius:34px;background:#342450;text-align:center;box-shadow:0 0 0 6px #2A1416,0 20px 0 #2A1416,0 40px 90px rgba(0,0,0,.45)}.ticket-booth .h2{color: var(--pink-text)}.ticket-booth .lede{text-align:center}.booth-small{color:#B7A9C1;font:.68rem var(--f-mono)}.booth-lights{width:100%;height:16px;margin-bottom:8px;background:radial-gradient(circle,var(--lime) 0 5px,transparent 6px) 0 0/34px 16px;filter:drop-shadow(0 0 6px var(--lime))}.lunapark-page .inside-nav{border:2px solid rgba(244,165,212,.3);background:rgba(52,36,80,.9)}
  @keyframes park-bulb{50%{background:var(--pink);box-shadow:0 0 18px var(--pink)}}@keyframes park-stars{50%{transform:scale(1.08);opacity:.65}}
  .lunapark-page{--cabinet:#342450}.lunapark-page .page-head{align-items:center}.ticket{flex:none;display:grid;gap:3px;min-width:150px;padding:15px 22px;border:2px dashed var(--night);border-radius:14px;background:var(--lime);color:var(--night);transform:rotate(3deg);box-shadow:0 0 0 5px var(--lime)}.ticket span{font:800 .62rem var(--f-mono);letter-spacing:.16em}.ticket b{font:900 1.05rem var(--f-display)}.arcade-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.7fr);gap:16px;align-items:start}.game-machine{overflow:hidden;border:1px solid rgba(var(--fg-rgb), .12);border-radius:30px;background:var(--cabinet);box-shadow:0 22px 70px rgba(0,0,0,.28)}.marquee{position:relative;padding:22px 26px 20px;text-align:center;background:var(--pink);color:var(--night);border-bottom:5px solid #2A1416}.marquee:before,.marquee:after{content:"✦";position:absolute;top:50%;font-size:1.5rem;transform:translateY(-50%)}.marquee:before{left:24px}.marquee:after{right:24px}.marquee span{font:800 .66rem var(--f-mono);letter-spacing:.18em}.marquee h2{margin:2px 0 0;font:900 clamp(2.4rem,6vw,4.8rem)/.82 var(--f-display);letter-spacing:-.06em}.marquee p{margin:8px 0 0;font-weight:700}.game-hud{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(var(--fg-rgb), .12);border-bottom:1px solid rgba(var(--fg-rgb), .12)}.game-hud>div{display:grid;justify-items:center;padding:12px;background:#17101f}.game-hud span{color:#AFA3BA;font:650 .64rem var(--f-mono);letter-spacing:.12em;text-transform:uppercase}.game-hud b{color: var(--lime-text);font:850 1.3rem var(--f-mono);font-variant-numeric:tabular-nums}.game-stage{position:relative;min-height:clamp(400px,58vw,590px);background:#0B0F0D;isolation:isolate}.game-stage canvas{display:block;width:100%;height:clamp(400px,58vw,590px);touch-action:none;cursor:crosshair}.game-overlay{position:absolute;inset:0;z-index:2;display:grid;place-content:center;justify-items:center;gap:13px;padding:26px;text-align:center;background:rgba(var(--bg-rgb), .72);backdrop-filter:blur(7px)}.game-overlay h3{max-width:620px;margin:0;color: var(--fg);font:850 clamp(2rem,5vw,4rem)/.92 var(--f-display);letter-spacing:-.04em}.game-overlay p:not(.eyebrow){max-width:460px;margin:0;color:var(--soft)}.game-overlay .lime{color: var(--lime-text)}.game-overlay .pink{color: var(--pink-text)}.result-actions{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px}.result-actions span{color: var(--mint-text);font:.72rem var(--f-mono)}.controls{display:flex;justify-content:center;flex-wrap:wrap;gap:10px 24px;padding:15px 20px;color:#C9BFCE;background:#17101f;font:.72rem var(--f-mono)}.controls span{display:flex;align-items:center;gap:5px}.controls span:before{content:"•";color: var(--lime-text)}kbd{padding:3px 6px;border:1px solid rgba(var(--fg-rgb), .24);border-radius:5px;background:#0B0F0D;color: var(--fg);font:inherit}.leaderboard{position:sticky;top:145px;display:grid;gap:18px}.period-tabs{display:flex;gap:5px;padding:4px;border-radius:999px;background:var(--bg)}.period-tabs button{flex:1;padding:8px 7px;border:0;border-radius:999px;background:transparent;color:var(--muted);font:700 .68rem var(--f-mono);cursor:pointer}.period-tabs button.active{background:var(--lime);color:var(--night)}.my-rank{display:grid;gap:3px;padding:14px;border:1px solid rgba(205,220,39,.25);border-radius:15px;background:rgba(205,220,39,.07)}.my-rank span{color:var(--muted);font:.65rem var(--f-mono);text-transform:uppercase}.my-rank b{color: var(--fg)}.rank-list{display:grid;gap:8px;margin:0;padding:0;list-style:none}.rank-item{display:grid;grid-template-columns:28px 42px minmax(0,1fr) auto;gap:9px;align-items:center;padding:9px;border-radius:14px;background:var(--bg)}.rank-item.me{box-shadow:inset 0 0 0 1.5px var(--lime)}.rank-number{color: var(--pink-text);font:800 .8rem var(--f-mono);text-align:center}.rank-bug{width:42px;height:42px;display:grid;place-items:center;overflow:hidden;border-radius:11px;background:var(--purple)}.rank-bug svg{width:100%;height:100%;object-fit:contain}.rank-copy{min-width:0;display:grid}.rank-copy b{overflow:hidden;color: var(--fg);font-size:.86rem;text-overflow:ellipsis;white-space:nowrap}.rank-copy span{color:var(--muted);font:.62rem var(--f-mono)}.rank-score{color: var(--lime-text);font:800 .75rem var(--f-mono);font-variant-numeric:tabular-nums}.rank-empty{padding:18px;text-align:center;color:var(--muted);font-size:.88rem}.leaderboard-note{margin:0;color:var(--muted);font:.67rem/1.5 var(--f-mono)}
  #game-lives{color: var(--pink-text);letter-spacing:.12em}.game-overlay .mint{color: var(--mint-text)}.fire-button{position:absolute;right:18px;bottom:18px;z-index:1;width:82px;aspect-ratio:1;border:4px solid #2A1416;border-radius:50%;background:var(--mint);color:var(--night);box-shadow:0 6px 0 #2A1416;font:900 .82rem var(--f-mono);cursor:pointer;touch-action:manipulation}.fire-button:active{transform:translateY(5px);box-shadow:0 1px 0 #2A1416}
  .club main>.lunapark-page{justify-self:stretch;width:auto!important;min-width:0;max-width:100%!important;padding-inline:0}.lunapark-page>#page-app,.lunapark-page>.page-loading,.lunapark-page>.page-out{width:100%;min-width:0;max-width:100%;overflow-x:clip}.lunapark-page>.page-loading{padding-inline:clamp(16px,3vw,48px)}.park-entrance{width:100%;min-width:0;padding-inline:clamp(16px,3vw,48px)}.entrance-sign{width:min(1120px,calc(100vw - clamp(32px,6vw,96px)));min-width:0;max-width:100%;box-sizing:border-box}.entrance-bottom{min-width:0}.park-strip{width:100%;min-width:0;box-sizing:border-box;margin:0 0 18px;border-inline:0;border-radius:0;padding-inline:clamp(18px,3vw,48px)}.arcade-layout{width:100%;min-width:0;box-sizing:border-box;grid-template-columns:minmax(0,1fr) minmax(350px,24vw);padding-inline:clamp(12px,2vw,34px)}.game-machine,.leaderboard{min-width:0}.game-stage,.game-stage canvas{height:min(72vh,760px);max-height:760px}
  .park-entrance{position:relative;min-height:clamp(570px,67vw,760px);align-content:center;isolation:isolate}.park-entrance>*:not(.side-attraction):not(.coaster){position:relative;z-index:3}.side-attraction{position:absolute;z-index:1;pointer-events:none}.ferris-attraction{left:clamp(-90px,-3vw,-20px);bottom:40px;width:clamp(220px,24vw,410px);aspect-ratio:1}.ferris-wheel{position:absolute;inset:0;border:7px solid var(--pink);border-radius:50%;background:repeating-conic-gradient(from 0deg,rgba(244,165,212,.85) 0 1.2deg,transparent 1.2deg 30deg);box-shadow:0 0 24px rgba(244,165,212,.65),inset 0 0 18px rgba(244,165,212,.4);animation:wheel-spin 22s linear infinite}.ferris-wheel:after{content:"";position:absolute;inset:43%;border:5px solid #2A1416;border-radius:50%;background:var(--lime);box-shadow:0 0 20px var(--lime)}.ferris-wheel i{position:absolute;left:46%;top:-12px;width:8%;height:22px;border:3px solid #2A1416;border-radius:6px;background:var(--mint);transform-origin:50% calc(clamp(110px,12vw,205px) + 12px)}.ferris-wheel i:nth-child(2){transform:rotate(45deg)}.ferris-wheel i:nth-child(3){transform:rotate(90deg)}.ferris-wheel i:nth-child(4){transform:rotate(135deg)}.ferris-wheel i:nth-child(5){transform:rotate(180deg)}.ferris-wheel i:nth-child(6){transform:rotate(225deg)}.ferris-wheel i:nth-child(7){transform:rotate(270deg)}.ferris-wheel i:nth-child(8){transform:rotate(315deg)}.ferris-legs:before,.ferris-legs:after{content:"";position:absolute;z-index:-1;bottom:-38px;left:48%;width:8px;height:56%;border-radius:8px;background:#2A1416;transform-origin:bottom}.ferris-legs:before{transform:rotate(24deg)}.ferris-legs:after{transform:rotate(-24deg)}.swing-attraction{right:clamp(-80px,-2vw,-16px);top:90px;width:clamp(210px,22vw,370px);height:430px;filter:drop-shadow(0 0 14px rgba(205,220,39,.4))}.swing-top{position:absolute;left:5%;top:30px;width:90%;height:85px;border:6px solid #2A1416;border-radius:50% 50% 18% 18%;background:repeating-conic-gradient(from 10deg,var(--pink) 0 12deg,var(--purple) 12deg 24deg);animation:swing-top 1.4s ease-in-out infinite alternate}.swing-top:before{content:"";position:absolute;left:35%;top:-55px;width:30%;height:68px;clip-path:polygon(50% 0,100% 100%,0 100%);background:var(--lime);border-radius:40%}.swing-pole{position:absolute;left:48%;top:94px;width:15px;height:305px;border-radius:9px;background:linear-gradient(90deg,var(--pink),var(--lime),var(--pink));box-shadow:0 0 18px var(--pink)}.swing-attraction>i{position:absolute;top:105px;left:50%;width:3px;height:155px;background:var(--fg);transform-origin:top}.swing-attraction>i:after{content:"";position:absolute;left:-14px;bottom:-16px;width:31px;height:20px;border:3px solid #2A1416;border-radius:4px 4px 10px 10px;background:var(--mint)}.swing-attraction>i:nth-of-type(1){transform:rotate(36deg)}.swing-attraction>i:nth-of-type(2){transform:rotate(18deg)}.swing-attraction>i:nth-of-type(3){transform:rotate(-8deg)}.swing-attraction>i:nth-of-type(4){transform:rotate(-25deg)}.swing-attraction>i:nth-of-type(5){transform:rotate(-42deg)}.coaster{position:absolute!important;z-index:0!important;left:0;right:0;bottom:0;width:100%;height:230px;opacity:.48;overflow:visible}.coaster path{fill:none;stroke:#2A1416;stroke-width:22}.coaster .coaster-rails{stroke:var(--pink);stroke-width:6;stroke-dasharray:2 16;filter:drop-shadow(0 0 7px var(--pink));animation:coaster-lights 1.4s linear infinite}@keyframes swing-top{to{transform:rotate(3deg) translateY(5px)}}@keyframes coaster-lights{to{stroke-dashoffset:-36}}
  .attraction-lobby{padding:clamp(38px,6vw,84px) clamp(16px,4vw,64px);background:radial-gradient(circle at 50% 0,rgba(244,165,212,.13),transparent 38rem)}.lobby-head{display:grid;gap:8px;max-width:760px;margin:0 auto clamp(28px,4vw,48px);text-align:center}.lobby-head h2{margin:0;color: var(--pink-text);font:900 clamp(2.7rem,6vw,5.7rem)/.86 var(--f-display);letter-spacing:-.055em}.lobby-head>p:last-child{margin:0;color:#BEB4C6}.attraction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:1500px;margin:auto}.attraction-card{position:relative;display:grid;grid-template-rows:170px auto auto 1fr auto;gap:8px;min-width:0;padding:16px;border:2px solid rgba(244,165,212,.22);border-radius:26px;background:#17101F;color: var(--fg);text-align:left;overflow:hidden}.attraction-card.available{cursor:pointer;transition:transform .2s,border-color .2s,box-shadow .2s}.attraction-card.available:hover{transform:translateY(-7px) rotate(-.5deg);border-color:var(--pink);box-shadow:0 18px 50px rgba(244,165,212,.18)}.ride-status{position:absolute;z-index:2;top:14px;right:14px;padding:5px 9px;border-radius:999px;background:var(--bg);color: var(--lime-text);font:800 .62rem var(--f-mono);text-transform:uppercase}.attraction-card.soon .ride-status{color:var(--muted)}.attraction-card strong{color: var(--pink-text);font:850 clamp(1.45rem,2.4vw,2.1rem)/1 var(--f-display)}.attraction-card small{color:#BEB4C6;font-size:.9rem}.attraction-card em{margin-top:8px;color: var(--lime-text);font:800 .72rem var(--f-mono);font-style:normal;text-transform:uppercase}.attraction-card.soon{opacity:.64}.ride-icon{position:relative;display:grid;place-items:center;border-radius:18px;background:linear-gradient(145deg,#342450,#0B0F0D);overflow:hidden}.rush-icon b{position:relative;z-index:2;color:var(--night);font:950 2rem var(--f-display)}.rush-icon:before{content:"";position:absolute;width:105px;aspect-ratio:1;border:7px solid #2A1416;border-radius:50%;background:var(--pink);box-shadow:0 0 0 8px var(--lime),0 0 40px rgba(205,220,39,.45)}.rush-icon i{position:absolute;width:72px;height:7px;border-radius:10px;background:var(--mint);transform-origin:left}.rush-icon i:nth-child(1){transform:translateX(38px) rotate(-28deg)}.rush-icon i:nth-child(2){transform:translateX(38px)}.rush-icon i:nth-child(3){transform:translateX(38px) rotate(28deg)}.fix-icon{grid-template-columns:auto auto auto;gap:10px;color: var(--pink-text);font:900 1.4rem var(--f-mono)}.fix-icon i{color: var(--lime-text);font-style:normal}.swarm-icon{display:block}.swarm-icon i{position:absolute;width:42px;aspect-ratio:1;border:4px solid #2A1416;border-radius:50%;background:var(--mint);box-shadow:0 0 18px rgba(61,219,154,.3)}.swarm-icon i:nth-child(1){left:19%;top:32%}.swarm-icon i:nth-child(2){left:38%;top:17%;background:var(--pink)}.swarm-icon i:nth-child(3){right:19%;top:35%;background:var(--lime)}.swarm-icon i:nth-child(4){left:35%;bottom:15%;background:#fff}.swarm-icon i:nth-child(5){right:30%;bottom:17%;background:var(--purple)}.lobby-lower{display:grid;grid-template-columns:minmax(320px,680px) minmax(280px,480px);justify-content:center;gap:18px;padding:0 clamp(16px,4vw,64px) clamp(50px,8vw,100px)}.lobby-lower .leaderboard{position:static}.park-poster{display:grid;align-content:center;justify-items:center;padding:32px;border:7px solid var(--pink);border-radius:28px;background:var(--lime);color:var(--night);text-align:center;box-shadow:9px 10px 0 #2A1416;transform:rotate(1.5deg)}.park-poster span,.park-poster small{font:800 .7rem var(--f-mono);letter-spacing:.12em}.park-poster strong{margin:12px 0;font:950 clamp(2.4rem,5vw,4.8rem)/.8 var(--f-display);letter-spacing:-.05em}
