---
import Club from '../../layouts/Club.astro';
import InsideNav from '../../components/InsideNav.astro';
import '../../styles/inside-pages.css';
---
<Club title="Account · Inside · techRebels" description="Manage your techRebels account, contact emails and notifications.">
  <section class="block first inside-page account-page">
    <div class="page-loading" id="page-loading"><p class="eyebrow">Inside · Account</p><h1 class="h2">Loading account…</h1></div>
    <div class="page-out" id="page-out" hidden><p class="eyebrow">Inside · Account</p><h1 class="h2">Log in to continue.</h1><a class="pill pill-pink" href="/login?next=%2Finside%2Faccount">Log in</a></div>
    <div id="page-app" hidden>
      <header class="page-head"><div><p class="eyebrow">Inside · Account</p><h1 class="h2">Your account, your signal.</h1><p class="lede">Keep security separate from the inbox you actually want us to use. Every optional notification is yours to control.</p></div></header>
      <InsideNav active="account" />
      <div class="account-grid">
        <section class="page-panel identity-card">
          <p class="eyebrow">Account & security email</p><h2 class="account-email" id="account-email"></h2><div class="account-roles" id="account-roles"></div>
          <p class="section-copy">Used for login, password resets, application decisions and important security messages. It cannot be disabled here.</p>
          <div class="form-actions"><a class="pill pill-pink" href="/forgot-password">Change password</a><button class="pill pill-ghost" id="signout" type="button">Sign out</button></div>
        </section>
        <section class="page-panel privacy-card"><p class="eyebrow">Your data</p><h2 class="section-title">Privacy controls</h2><p class="section-copy">Your community profile and matching consent are separate from email preferences. You may also request a copy or correction of your data.</p><div class="form-actions"><a class="pill pill-ghost" href="/inside/profile">Profile & matching</a><a class="pill pill-ghost" href="/privacy">Privacy notice</a></div></section>
        <section class="page-panel contact-card">
          <div><p class="eyebrow">Contact emails</p><h2 class="section-title">Where should we reach you?</h2><p class="section-copy">Add a personal and/or company address. We only save it after you verify the six-digit code sent there.</p></div>
          <div class="email-slots">
            <div class="email-slot">
              <div class="slot-head"><div><strong>Personal email</strong><span id="personal-current">Not added</span></div><span class="verified" id="personal-verified" hidden>Verified ✓</span></div>
              <div class="email-entry" id="personal-entry"><input type="email" id="personal-input" autocomplete="email" placeholder="you@personal.com" aria-label="Personal email" /><button class="pill pill-ghost" data-send="personal" type="button">Send code</button></div>
              <div class="code-entry" id="personal-code-row" hidden><input type="text" id="personal-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6-digit code" aria-label="Personal email verification code" /><button class="pill pill-pink" data-verify="personal" type="button">Verify</button></div>
              <button class="text-action" id="personal-remove" data-remove="personal" type="button" hidden>Remove personal email</button><p class="slot-status" id="personal-status" role="status"></p>
            </div>
            <div class="email-slot">
              <div class="slot-head"><div><strong>Company email</strong><span id="company-current">Not added</span></div><span class="verified" id="company-verified" hidden>Verified ✓</span></div>
              <div class="email-entry" id="company-entry"><input type="email" id="company-input" autocomplete="email" placeholder="you@company.com" aria-label="Company email" /><button class="pill pill-ghost" data-send="company" type="button">Send code</button></div>
              <div class="code-entry" id="company-code-row" hidden><input type="text" id="company-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6-digit code" aria-label="Company email verification code" /><button class="pill pill-pink" data-verify="company" type="button">Verify</button></div>
              <button class="text-action" id="company-remove" data-remove="company" type="button" hidden>Remove company email</button><p class="slot-status" id="company-status" role="status"></p>
            </div>
          </div>
        </section>
        <form class="page-panel notification-card" id="notification-form">
          <div><p class="eyebrow">Notification settings</p><h2 class="section-title">Choose what gets through.</h2><p class="section-copy">Silence everything optional, or keep only the signals you care about.</p></div>
          <label class="preferred">Preferred contact email<select id="preferred-email"><option value="account">Account / login email</option><option value="personal" id="preferred-personal" disabled>Personal email — add & verify first</option><option value="company" id="preferred-company" disabled>Company email — add & verify first</option></select></label>
          <div class="notification-list">
            <label class="check"><input type="checkbox" id="notify-events" /><span><b>Events & reminders</b><small>New Sessions, registration openings and reminders for events you joined.</small></span></label>
            <label class="check"><input type="checkbox" id="notify-matching" /><span><b>Matching updates</b><small>A new bug buddy, squad or approved introduction.</small></span></label>
            <label class="check"><input type="checkbox" id="notify-drop" /><span><b>The Drop</b><small>Merch availability and updates about pieces you showed interest in.</small></span></label>
            <label class="check"><input type="checkbox" id="notify-news" /><span><b>General community news</b><small>Occasional stories and broader techRebels updates. Events stay separate.</small></span></label>
          </div>
          <div class="always-on"><i aria-hidden="true"></i><span><b>Always on:</b> account security, password resets and application decisions go to your login email.</span></div>
          <p class="error" id="notification-error" hidden></p><div class="form-actions"><button class="pill pill-pink" id="notification-save" type="submit">Save preferences</button><span class="status" id="notification-status" role="status"></span></div>
        </form>
        <section class="page-panel danger-card"><p class="eyebrow">Danger zone</p><h2 class="section-title" id="danger-title">Ragequit</h2><p class="section-copy" id="danger-copy">Leaving? Do it with style. This permanently removes your profile, bug, application, votes, matching data and merch signals. It cannot be undone. Your bug can leave a ghost and a last message on the Ragequit wall, without your name.</p><button class="pill pill-ghost danger" id="delete-start" type="button">Ragequit (delete my account)</button><div class="delete-confirm" id="delete-confirm" hidden><p>Type <strong id="confirm-email"></strong> to confirm.</p><input type="email" id="delete-email" autocomplete="off" /><label class="rq-field">Last words <span>(optional, max 140, shown without your name)</span><input type="text" id="rq-msg" maxlength="140" placeholder="I came for the bugs, I left because of the bugs." /></label><label class="rq-check"><input type="checkbox" id="rq-ghost" checked /> Leave my bug's ghost on the Ragequit wall</label><p class="error" id="delete-error" hidden></p><div class="form-actions"><button class="pill pill-pink" id="delete-yes" type="button">Delete forever</button><button class="pill pill-ghost" id="delete-no" type="button">Cancel</button></div></div></section>
      </div>
    </div>
  </section>
</Club>

<style is:global>
  .rq-field{display:grid;gap:6px;margin-top:12px;font-weight:700;font-size:.88rem}.rq-field span{font:500 .72rem var(--f-mono);color:var(--muted)}.rq-check{display:flex;align-items:center;gap:8px;margin-top:10px;color:#C3CBC6;font-size:.9rem}.rq-check input{width:16px;height:16px;accent-color:var(--pink)}
  .rq-stage{position:fixed;inset:0;z-index:3000;display:grid;place-items:center;align-content:center;gap:16px;background:rgba(11,15,13,.96);overflow:hidden}
  .rq-sign{margin:0;font:800 clamp(3rem,12vw,8rem)/.9 var(--f-display);color:var(--pink);letter-spacing:-.04em;animation:rq-shake .5s steps(2) 3}
  .rq-bug{width:220px;animation:rq-walk 2.6s cubic-bezier(.5,0,.8,.4) .5s forwards}.rq-bug svg{width:100%;height:auto;display:block}
  .rq-say{margin:0;max-width:30ch;padding:12px 16px;border-radius:14px 14px 14px 4px;background:var(--bone);color:var(--night);font-weight:700;text-align:center;animation:rq-fade 2.6s ease .6s forwards}
  @keyframes rq-walk{30%{transform:translateX(-30px) rotate(-8deg)}100%{transform:translateX(120vw) rotate(25deg) scale(.6)}}
  @keyframes rq-fade{70%{opacity:1}100%{opacity:.25;transform:translateY(-10px)}}
  @keyframes rq-shake{50%{transform:translate(-6px,3px) rotate(-2deg)}}
  @media (prefers-reduced-motion: reduce){.rq-bug,.rq-say,.rq-sign{animation:none}}
  .account-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.account-grid .contact-card,.account-grid .notification-card,.account-grid .danger-card{grid-column:1/-1}.account-grid .danger-card{border-color:rgba(244,165,212,.35)}.account-email{margin:10px 0 14px;color:var(--bone);font:800 clamp(1.25rem,2.6vw,2rem)/1.1 var(--f-display);overflow-wrap:anywhere}.account-roles{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:18px}.account-roles span{padding:5px 9px;border-radius:999px;background:rgba(61,219,154,.12);color:var(--mint);font:700 .68rem var(--f-mono);text-transform:uppercase}.identity-card .form-actions,.privacy-card .form-actions,.danger-card>button{margin-top:22px}.contact-card{display:grid;gap:24px}.email-slots{display:grid;grid-template-columns:1fr 1fr;gap:14px}.email-slot{display:grid;gap:12px;padding:18px;border:1px solid rgba(237,231,220,.1);border-radius:18px;background:var(--night)}.slot-head{display:flex;justify-content:space-between;align-items:start;gap:12px}.slot-head>div{display:grid;gap:3px}.slot-head strong{color:var(--bone)}.slot-head span:not(.verified){color:var(--muted);font:.8rem var(--f-mono);overflow-wrap:anywhere}.verified{color:var(--mint);font:700 .72rem var(--f-mono);white-space:nowrap}.email-entry,.code-entry{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.account-page input[type=email],.account-page input[type=text]{width:100%;min-width:0;border:1.5px solid rgba(237,231,220,.16);border-radius:14px;padding:12px 14px;background:var(--night-2);color:var(--bone);font:500 1rem "Satoshi",system-ui,sans-serif}.email-slot .pill{padding:11px 16px}.text-action{justify-self:start;padding:0;border:0;background:transparent;color:var(--pink);font:700 .78rem var(--f-mono);cursor:pointer}.slot-status{min-height:1.2em;margin:0;color:var(--mint);font:.78rem var(--f-mono)}.notification-card{display:grid;gap:22px}.preferred{max-width:560px}.notification-list{display:grid;grid-template-columns:1fr 1fr;gap:10px}.notification-list .check{padding:16px;border:1px solid rgba(237,231,220,.1);border-radius:16px;background:var(--night)}.notification-list .check span{display:grid;gap:3px}.notification-list small{color:var(--muted);font-weight:500}.always-on{display:flex;align-items:flex-start;gap:10px;padding:14px;border-radius:14px;background:rgba(205,220,39,.08);color:#C3CBC6}.always-on i{flex:none;width:8px;height:8px;margin-top:7px;border-radius:50%;background:var(--lime)}.danger{color:var(--pink)}.delete-confirm{display:grid;gap:12px;margin-top:18px;padding:18px;border-radius:18px;border:1.5px solid var(--pink)}.delete-confirm p{margin:0;color:#C3CBC6}.delete-confirm input{max-width:420px}
  @media(max-width:760px){.account-grid,.email-slots,.notification-list{grid-template-columns:1fr}.account-grid .contact-card,.account-grid .notification-card,.account-grid .danger-card{grid-column:auto}.email-entry,.code-entry{grid-template-columns:1fr}.email-slot .pill{justify-content:center}}
</style>

<script>
  import { bugSVG } from '../../lib/bug/render.js';
  import { supabase } from '../../lib/supabase';
  const $=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;type ContactKind='personal'|'company';let email='';let profile:any=null;
  function renderContact(kind:ContactKind){const value=profile?.[`${kind}_email`]??'';$(`${kind}-current`).textContent=value||'Not added';$(`${kind}-verified`).hidden=!value;$(`${kind}-entry`).hidden=!!value;$(`${kind}-remove`).hidden=!value;const option=$<HTMLOptionElement>(`preferred-${kind}`);option.disabled=!value;option.textContent=value?`${kind==='personal'?'Personal':'Company'} — ${value}`:`${kind==='personal'?'Personal':'Company'} email — add & verify first`;}
  function renderPreferences(){renderContact('personal');renderContact('company');$<HTMLSelectElement>('preferred-email').value=profile?.preferred_contact_email??'account';$<HTMLInputElement>('notify-events').checked=!!profile?.notify_events;$<HTMLInputElement>('notify-matching').checked=!!profile?.notify_matching;$<HTMLInputElement>('notify-drop').checked=!!profile?.notify_drop;$<HTMLInputElement>('notify-news').checked=!!profile?.marketing_consent;}
  async function loadProfile(uid:string){const {data,error}=await supabase!.from('profiles').select('personal_email,company_email,preferred_contact_email,notify_events,notify_matching,notify_drop,marketing_consent').eq('id',uid).maybeSingle();if(error)throw error;profile=data??{};renderPreferences();}
  async function start(){if(!supabase){$('page-loading').hidden=true;$('page-out').hidden=false;return;}const {data}=await supabase.auth.getSession();const user=data.session?.user;if(!user){$('page-loading').hidden=true;$('page-out').hidden=false;return;}email=user.email??'';const [{data:member},{data:admin},{data:roles}]=await Promise.all([supabase.rpc('is_member'),supabase.rpc('is_admin'),supabase.from('user_roles').select('role').eq('user_id',user.id)]);$('page-loading').hidden=true;if(!member&&!admin&&(roles??[]).length===0){location.replace('/inside');return;}$('page-app').hidden=false;$('account-email').textContent=email;$('confirm-email').textContent=email;const names=(roles??[]).map((row:any)=>row.role);if(admin&&!names.includes('admin'))names.push('admin');$('account-roles').replaceChildren(...names.map((role:string)=>Object.assign(document.createElement('span'),{textContent:role})));if(admin){$('danger-title').textContent='Admin account protected';$('danger-copy').textContent='Another admin must remove your admin role before this account can be deleted. This protects the community from losing its last administrator.';$('delete-start').hidden=true;}try{await loadProfile(user.id);}catch{$('notification-error').textContent='Preferences could not be loaded. Make sure the latest database migration is installed.';$('notification-error').hidden=false;}}
  async function functionMessage(error:any){try{return (await error?.context?.json())?.error||error?.message||'Something went wrong.';}catch{return error?.message||'Something went wrong.';}}
  function setupAccountPage(){if(!document.querySelector('.account-page'))return;
    $('signout').addEventListener('click',async()=>{await supabase?.auth.signOut();location.href='/';});
    document.querySelectorAll<HTMLButtonElement>('[data-send]').forEach(button=>button.addEventListener('click',async()=>{if(!supabase)return;const kind=button.dataset.send as ContactKind;const input=$<HTMLInputElement>(`${kind}-input`);const status=$(`${kind}-status`);status.textContent='';if(!input.validity.valid||!input.value.trim()){status.textContent='Add a valid email address.';return;}button.disabled=true;status.textContent='Sending…';const {error}=await supabase.functions.invoke('manage-contact-email',{body:{action:'send',kind,email:input.value.trim()}});button.disabled=false;if(error){status.textContent=await functionMessage(error);return;}$(`${kind}-code-row`).hidden=false;$<HTMLInputElement>(`${kind}-code`).focus();status.textContent='Code sent. It expires in 15 minutes.';}));
    document.querySelectorAll<HTMLButtonElement>('[data-verify]').forEach(button=>button.addEventListener('click',async()=>{if(!supabase)return;const kind=button.dataset.verify as ContactKind;const code=$<HTMLInputElement>(`${kind}-code`).value.trim();const status=$(`${kind}-status`);if(!/^\d{6}$/.test(code)){status.textContent='Enter the six-digit code.';return;}button.disabled=true;status.textContent='Verifying…';const {error}=await supabase.functions.invoke('manage-contact-email',{body:{action:'verify',kind,code}});button.disabled=false;if(error){status.textContent=await functionMessage(error);return;}const {data}=await supabase.auth.getSession();if(data.session?.user)await loadProfile(data.session.user.id);$(`${kind}-code-row`).hidden=true;status.textContent='Email verified ✓';}));
    document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(button=>button.addEventListener('click',async()=>{if(!supabase)return;const kind=button.dataset.remove as ContactKind;if(!confirm(`Remove your ${kind} email?`))return;button.disabled=true;const {error}=await supabase.rpc('remove_contact_email',{p_kind:kind});button.disabled=false;if(error){$(`${kind}-status`).textContent='Removing failed. Try again.';return;}profile[`${kind}_email`]=null;if(profile.preferred_contact_email===kind)profile.preferred_contact_email='account';renderPreferences();$(`${kind}-status`).textContent='Email removed.';}));
    $('notification-form').addEventListener('submit',async(event)=>{event.preventDefault();if(!supabase)return;const button=$<HTMLButtonElement>('notification-save');const errorBox=$('notification-error');errorBox.hidden=true;button.disabled=true;$('notification-status').textContent='Saving…';const {error}=await supabase.rpc('update_notification_preferences',{p_preferred:$<HTMLSelectElement>('preferred-email').value,p_events:$<HTMLInputElement>('notify-events').checked,p_matching:$<HTMLInputElement>('notify-matching').checked,p_drop:$<HTMLInputElement>('notify-drop').checked,p_news:$<HTMLInputElement>('notify-news').checked});button.disabled=false;if(error){$('notification-status').textContent='';errorBox.textContent='Saving failed. Try again.';errorBox.hidden=false;return;}$('notification-status').textContent='Saved ✓';});
    $('delete-start').addEventListener('click',()=>{$('delete-confirm').hidden=false;$<HTMLInputElement>('delete-email').focus();});$('delete-no').addEventListener('click',()=>{$('delete-confirm').hidden=true;});
    $('delete-yes').addEventListener('click',async()=>{
      if(!supabase)return;
      const input=$<HTMLInputElement>('delete-email');const error=$('delete-error');error.hidden=true;
      if(input.value.trim().toLowerCase()!==email.toLowerCase()){error.textContent='The email does not match.';error.hidden=false;return;}
      const button=$<HTMLButtonElement>('delete-yes');button.disabled=true;
      const message=$<HTMLInputElement>('rq-msg').value.trim().slice(0,140);
      const ghost=$<HTMLInputElement>('rq-ghost').checked;
      const {data:who}=await supabase.auth.getUser();const {data:mine}=await supabase.from('bugs').select('config').eq('user_id',who.user?.id??'').maybeSingle();
      const {error:deleteError}=await supabase.rpc('ragequit',{p_message:message||null,p_keep_ghost:ghost});
      if(deleteError){button.disabled=false;error.textContent='Even ragequitting failed. Contact the crew and we will remove it manually.';error.hidden=false;return;}
      await supabase.auth.signOut();
      await farewell(mine?.config??null,message);
      location.href=ghost?'/swarm#ghosts':'/';
    });
    // the bug walks off screen, leaving its last words behind
    function farewell(config:Record<string,unknown>|null,message:string){return new Promise<void>((done)=>{
      const stage=document.createElement('div');stage.className='rq-stage';
      const bug=document.createElement('div');bug.className='rq-bug';if(config)bug.innerHTML=bugSVG(config as never,220);
      const say=document.createElement('p');say.className='rq-say';say.textContent=message||'Bye. Do not miss me.';
      const sign=document.createElement('p');sign.className='rq-sign';sign.textContent='RAGEQUIT';
      stage.append(sign,bug,say);document.body.append(stage);
      setTimeout(done,matchMedia('(prefers-reduced-motion: reduce)').matches?900:3200);
    });}
    start();}
  document.addEventListener('astro:page-load',setupAccountPage);
</script>
