---
import Club from '../layouts/Club.astro';
import Intro from '../components/Intro.astro';
import Bug from '../components/Bug';
import { SPECIES } from '../lib/bug/render.js';
import { site, session } from '../config/site';
import { news } from '../config/news';

// Home: hero, Bug Lab teaser, what's happening. Other sections live on their own pages.
const hero = {
  main: { role: 'dev', shape: 'round', shell: 'green', pattern: 'circuit', eyes: 'visor', mouth: 'grin', antennae: 'plug', hat: 'headphones', pose: 'stomp', attitude: 'rebel', accent: 'mint' },
  left: { role: 'design', shape: 'tall', shell: 'purple', pattern: 'dots', eyes: 'hearts', mouth: 'smirk', antennae: 'cursor', hat: 'beret', pose: 'lean', attitude: 'smug' },
  right: { role: 'marketing', shape: 'wide', shell: 'lime', pattern: 'pixels', eyes: 'googly', eyewear: 'heartshades', mouth: 'tongue', antennae: 'match', hat: 'party', pose: 'wave', attitude: 'excited' },
};


const sp = (name: string) => SPECIES.findIndex((s) => s[0] === name);
const roleBugs = [
  ['Dev', 'Merge conflict', 'var(--green)', { role: 'dev', shape: 'round', shell: 'pink', pattern: 'code', eyes: 'visor', mouth: 'grin', antennae: 'plug', hat: 'headphones', pose: 'stomp', attitude: 'rebel' }],
  ['AI', 'Hallucination', 'var(--lime)', { role: 'ai', shape: 'tall', shell: 'purple', pattern: 'circuit', eyes: 'glitch', mouth: 'o', antennae: 'wifi', hat: 'none', pose: 'hype', attitude: 'excited', extra: 'sparkles' }],
  ['Marketing', 'Viral loop', 'var(--purple)', { role: 'marketing', shape: 'round', shell: 'pink', pattern: 'dots', eyes: 'googly', eyewear: 'heartshades', mouth: 'tongue', antennae: 'match', hat: 'party', pose: 'wave', attitude: 'excited' }],
  ['Sales', 'Pipeline leak', 'var(--mint)', { role: 'sales', shape: 'wide', shell: 'brown', pattern: 'stripes', eyes: 'googly', eyewear: 'shades', mouth: 'grin', antennae: 'classic', hat: 'headset', pose: 'wave', attitude: 'rebel' }],
  ['Product', 'Scope creep', 'var(--pink)', { role: 'product', shape: 'tall', shell: 'lime', pattern: 'stripes', eyes: 'sleepy', mouth: 'o', antennae: 'classic', hat: 'cap', pose: 'jump', attitude: 'worried', extra: 'sweat' }],
  ['Design', 'Pixel pusher', 'var(--bug-brown)', { role: 'design', shape: 'round', shell: 'white', pattern: 'dots', eyes: 'hearts', mouth: 'smirk', antennae: 'cursor', hat: 'beret', pose: 'lean', attitude: 'smug' }],
] as const;

// Merch: simple garment silhouettes with a real bug print from the renderer
---
<Club>
  <Intro slot="before" />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A community for curious people in tech · Prague</p>
      <h1 class="hero-h">Rebels don't<br /><span class="nw">do <em>safe mode.</em></span></h1>
      <p class="hero-lede">techRebels is a club for people who build, break and rethink tech. Devs, PMs, designers, marketers, founders and the just curious. Real projects, real bugs, zero status games.</p>
      <div class="hero-cta">
        <a class="pill pill-pink" href="/lab">Join the swarm <span aria-hidden="true">→</span></a>
        <a class="pill pill-ghost" href="/sessions">Next Rebel Session</a>
      </div>
      <dl class="hero-meta">
        <div><dt>Next session</dt><dd>{session.name} · {session.date}</dd></div>
        <div><dt>Merch</dt><dd>Founding Drop 001 · soon</dd></div>
        <div><dt>Status</dt><dd>won't fix</dd></div>
      </dl>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="card c-main"><Bug config={hero.main} size={440} /><span class="tag">BUG-0100 · Merge conflict</span></div>
      <div class="card c-left"><Bug config={hero.left} size={220} /></div>
      <div class="card c-right"><Bug config={hero.right} size={220} /></div>
      <span class="stamp">Status:<br />won't fix</span>
    </div>
  </section>

  <!-- Marquee -->
  <div class="ticker" aria-label="Claims">
    <div class="ticker-track">
      {[0, 1].map((k) => (
        <span aria-hidden={k === 1 ? 'true' : undefined}>
          {site.claims.web.map((c) => <><b>{c}</b><i>✦</i></>)}
        </span>
      ))}
    </div>
  </div>


  <!-- Bug lab -->
  <section class="block roles-teaser" id="lab">
    <div class="head rv">
      <p class="eyebrow">Bug Lab</p>
      <h2 class="h2">Every rebel gets a bug.</h2>
      <p class="lede">No single mascot. A whole swarm. Pick a role, a body, a pose and an attitude. Your bug becomes your avatar, your name badge and your membership card.</p>
    </div>
    <div class="roles">
      {roleBugs.map(([role, species, tile, cfg]) => (
        <figure class="role rv">
          <div class="role-tile" style={`background:${tile}`}><Bug config={{ ...cfg, species: sp(species) }} size={220} label={`${role} bug`} /></div>
          <figcaption><b>{role}</b><span>{species}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="center rv"><a class="pill pill-pink" href="/lab">Build your bug <span aria-hidden="true">→</span></a></div>
  </section>


  <!-- What's happening -->
  <section class="block news" id="news">
    <div class="head rv">
      <p class="eyebrow">What's happening</p>
      <h2 class="h2">Now, next and lately.</h2>
    </div>
    <div class="news-list">
      {news.map((n) => (
        <article class={`news-item rv is-${n.when}`}>
          <div class="news-meta"><span class="news-when">{n.when === 'next' ? 'Coming up' : n.when === 'now' ? 'Live now' : 'Done'}</span><span>{n.date}</span><span class="news-tag">{n.tag}</span></div>
          <h3>{n.title}</h3>
          <p>{n.text}</p>
          {n.href && <a class="news-link" href={n.href}>{n.cta} <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final rv">
    <h2 class="final-h">Be the bug.</h2>
    <p>Build your bug, join the swarm and get first dibs on Rebel Session #01.</p>
    <a class="pill pill-pink" href="/lab">Join the swarm <span aria-hidden="true">→</span></a>
  </section>
</Club>
