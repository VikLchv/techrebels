---
import Club from '../layouts/Club.astro';
---
<Club title="Choose a new password · techRebels" description="Securely choose a new techRebels password.">
  <section class="block first auth-page">
    <div class="auth-card">
      <p class="eyebrow">Account recovery</p>
      <h1 class="h2">Choose a new password.</h1>
      <p class="lede">Use a unique password you do not use anywhere else.</p>
      <div id="reset-loading" class="auth-done"><p>Checking your reset link…</p></div>
      <div id="reset-invalid" class="auth-done auth-invalid" hidden>
        <h2>This link is invalid or expired.</h2>
        <p>Request a new password reset email. Reset links are deliberately short-lived.</p>
        <a class="pill pill-ghost" href="/forgot-password">Request another link</a>
      </div>
      <form id="reset-form" hidden novalidate>
        <label>New password<input type="password" id="reset-password" required autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="reset-hint" /></label>
        <p class="password-hint" id="reset-hint">At least 12 characters with uppercase, lowercase, a number and a symbol.</p>
        <label>Repeat new password<input type="password" id="reset-repeat" required autocomplete="new-password" minlength="12" maxlength="128" /></label>
        <p class="lerr" id="reset-error" role="alert" hidden></p>
        <button class="pill pill-pink" id="reset-submit" type="submit">Save new password <span aria-hidden="true">→</span></button>
      </form>
      <div id="reset-done" class="auth-done" hidden>
        <h2>Password changed.</h2>
        <p>All refresh sessions have been signed out. Log in again with your new password.</p>
        <a class="pill pill-lime" href="/login">Go to login</a>
      </div>
    </div>
  </section>
</Club>

<style is:global>
  .auth-card { max-width: 620px; display: grid; gap: 18px; }
  .auth-card form { display: grid; gap: 14px; }
  .auth-card label { display: grid; gap: 7px; font-weight: 700; }
  .auth-card input { width: 100%; border: 1.5px solid rgba(var(--fg-rgb), .16); border-radius: 14px; padding: 13px 15px; background: var(--bg-2); color: var(--fg); font: 500 1rem "Satoshi", system-ui, sans-serif; }
  .auth-card input:focus { outline: none; border-color: var(--lime); }
  .auth-card .pill { justify-self: start; margin-top: 8px; }
  .auth-card .lerr { margin: 0; color: var(--pink-text); font-weight: 700; }
  .password-hint { margin: -7px 0 0; color: var(--muted); font: 500 .76rem/1.45 var(--f-mono); }
  .auth-done { display: grid; gap: 10px; padding: 18px; border: 1.5px solid var(--lime); border-radius: 18px; }
  .auth-done h2, .auth-done p { margin: 0; }
  .auth-done h2 { color: var(--lime-text); font: 800 1.6rem var(--f-display); }
  .auth-invalid { border-color: var(--pink); }
  .auth-invalid h2 { color: var(--pink-text); }
</style>

<script>
  import { supabase } from '../lib/supabase';
  const loading = document.getElementById('reset-loading')!;
  const invalid = document.getElementById('reset-invalid')!;
  const form = document.getElementById('reset-form') as HTMLFormElement;
  let recoveryReady = false;
  const showForm = () => { if (recoveryReady) return; recoveryReady = true; loading.hidden = true; invalid.hidden = true; form.hidden = false; };
  const showInvalid = () => { if (recoveryReady) return; loading.hidden = true; invalid.hidden = false; };

  if (!supabase) showInvalid();
  else {
    supabase.auth.onAuthStateChange((event, session) => { if (event === 'PASSWORD_RECOVERY' && session) showForm(); });
    supabase.auth.getSession().then(({ data }) => { if (data.session) showForm(); else setTimeout(showInvalid, 1200); });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase) return;
    const password = document.getElementById('reset-password') as HTMLInputElement;
    const repeat = document.getElementById('reset-repeat') as HTMLInputElement;
    const errorBox = document.getElementById('reset-error')!;
    errorBox.hidden = true;
    const strong = password.value.length >= 12 && /[a-z]/.test(password.value) && /[A-Z]/.test(password.value) && /\d/.test(password.value) && /[^A-Za-z0-9]/.test(password.value);
    if (!strong) { errorBox.textContent = 'Use at least 12 characters with uppercase, lowercase, a number and a symbol.'; errorBox.hidden = false; password.focus(); return; }
    if (password.value !== repeat.value) { errorBox.textContent = 'The passwords do not match.'; errorBox.hidden = false; repeat.focus(); return; }
    const button = document.getElementById('reset-submit') as HTMLButtonElement;
    button.disabled = true;
    const { error } = await supabase.auth.updateUser({ password: password.value });
    if (error) { button.disabled = false; errorBox.textContent = 'The password could not be changed. Request a new reset link and try again.'; errorBox.hidden = false; return; }
    await supabase.auth.signOut({ scope: 'global' });
    form.hidden = true;
    document.getElementById('reset-done')!.hidden = false;
  });
</script>
