---
// The Swarm: every saved bug orbiting the brand, live.
import Club from '../layouts/Club.astro';
import '../styles/swarm.css';
---
<Club title="The Swarm · techRebels" description="Every bug made in the Bug Lab, orbiting techRebels live.">
  <section class="block first swarm-page">
    <div class="head">
      <p class="eyebrow">The Swarm</p>
      <h1 class="h2">The Swarm.</h1>
      <p class="lede">Every bug made in the Bug Lab joins one loop around the brand. At events it runs on the big screen and everyone hunts for their own. <b id="sw-count">0</b> bugs and counting.</p>
    </div>

    <div class="stage" id="stage" aria-label="Animated swarm of member bugs around the techRebels logo">
      <p class="stage-mark" aria-hidden="true"><span>tech</span><span>Rebels</span></p>
      <p class="stage-empty" id="sw-empty" hidden>The swarm is warming up. <a href="/lab">Be the first bug.</a></p>
    </div>

    <div class="sw-controls">
      <button type="button" class="pill pill-pink" id="sw-find" hidden>Find my bug</button>
      <button type="button" class="pill pill-ghost" id="sw-pause">Pause</button>
      <button type="button" class="pill pill-ghost" id="sw-fs">Full screen</button>
      <a class="pill pill-ghost" href="/swarm/live">Event screen ↗</a>
      <span class="sw-msg" id="sw-msg" role="status"></span>
    </div>

    <div class="sw-newest">
      <h2 class="sw-h">Newest bugs</h2>
      <div class="sw-grid" id="sw-grid"></div>
    </div>
  </section>

  <section class="block outbreak" id="outbreak">
    <div class="head">
      <p class="eyebrow">The outbreak</p>
      <h2 class="h2">Who infected whom.</h2>
      <p class="lede">Every member bug carries three infections. This is how the swarm spreads, one invite at a time.</p>
    </div>
    <div class="ob-tree" id="ob-tree"><p class="ob-empty">Tracing the infection…</p></div>
  </section>

  <section class="block ghosts" id="ghosts">
    <div class="head">
      <p class="eyebrow">Ragequit wall</p>
      <h2 class="h2">Gone, not forgotten.</h2>
      <p class="lede">Rebels who ragequit can leave their bug's ghost and a last message. No names, just the drama.</p>
    </div>
    <div class="gh-wall" id="gh-wall"><p class="ob-empty">Summoning ghosts…</p></div>
  </section>
</Club>

<style is:global>
  .ob-tree { display: grid; gap: 14px; margin-top: 20px; }
  .ob-empty { color: var(--muted); margin: 0; }
  .ob-chain { padding: 14px 16px; border-radius: 18px; background: var(--bg-2); border: 1px solid rgba(var(--fg-rgb), .08); }
  .ob-node { display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px 4px 4px; border-radius: 999px; background: rgba(var(--fg-rgb), .05); font: 700 .78rem var(--f-mono); }
  .ob-node svg { width: 34px; height: auto; }
  .ob-kids { list-style: none; margin: 8px 0 0 18px; padding: 0 0 0 16px; border-left: 2px dashed rgba(205, 220, 39, .45); display: grid; gap: 8px; }
  .ob-kids > li::before { content: "🦠 "; font-size: .8rem; }
  .gh-wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-top: 20px; }
  .gh-card { position: relative; display: grid; justify-items: center; gap: 10px; padding: 18px 14px; border-radius: 18px; background: var(--bg-2); border: 1px dashed rgba(var(--fg-rgb), .16); }
  .gh-card svg { width: 110px; height: auto; filter: grayscale(1) opacity(.45); animation: gh-float 5s ease-in-out infinite; }
  .gh-card blockquote { margin: 0; font: 600 .92rem/1.35 "Satoshi", system-ui, sans-serif; text-align: center; color: var(--fg); }
  .gh-card small { font: 500 .7rem var(--f-mono); color: var(--muted); }
  @keyframes gh-float { 50% { transform: translateY(-8px) rotate(3deg); } }
  @media (prefers-reduced-motion: reduce) { .gh-card svg { animation: none; } }

  .sw-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 20px; }
  .sw-controls .pill { padding: 11px 18px; font-size: .9rem; }
  .sw-msg { font: 500 .85rem var(--f-mono); color: var(--mint-text); }
  .sw-newest { margin-top: clamp(48px, 7vw, 88px); display: grid; gap: 20px; }
  .sw-h { margin: 0; font: 800 clamp(1.8rem, 3vw, 2.4rem)/1 var(--f-display); letter-spacing: -.03em; }
  .sw-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
  .sw-card { display: grid; gap: 8px; }
  .sw-card .tile { border-radius: 18px; padding: 8px; }
  .sw-card svg { display: block; width: 100%; height: auto; }
  .sw-card b { font-size: .98rem; overflow-wrap: anywhere; }
  .sw-card small { font: 500 .78rem var(--f-mono); color: var(--muted); }
  .sw-duel { justify-self: start; padding: 4px 10px; border-radius: 999px; border: 1.5px solid rgba(var(--fg-rgb), .2); font: 700 .74rem var(--f-mono); color: var(--fg); cursor: pointer; }
  .sw-duel:hover, .sw-duel:focus-visible { background: var(--pink); border-color: var(--pink); color: var(--night); }
  @media (max-width: 900px) { .sw-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .sw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { createOrbit, bugId, type SwarmBug } from '../lib/swarm/orbit';
  import { bugSVG, ROLES, SPECIES, COL } from '../lib/bug/render.js';
  import { track } from '../lib/track';
  import { onNewBug } from '../lib/swarm/live';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const stage = $('stage');
  const orbit = createOrbit(stage);
  let bugs: SwarmBug[] = [];
  let mine: number | null = null;

  const roleLabel = (r: string) => ROLES.find((x) => x[0] === r)?.[1] ?? r;
  const TILE: Record<string, string> = { green: COL.green, pink: COL.pink, lime: COL.lime, purple: COL.purple, mint: COL.mint, brown: COL.brown, white: COL.white };

  function renderGrid() {
    const grid = $('sw-grid');
    grid.replaceChildren();
    for (const b of bugs.slice(0, 24)) {
      const card = document.createElement('a');
      card.className = 'sw-card';
      card.href = `/swarm?highlight=${b.bug_number}`;
      const tile = document.createElement('div');
      tile.className = 'tile';
      tile.style.background = TILE[String(b.config.bg)] ?? COL.green;
      tile.innerHTML = bugSVG(b.config, 180);
      const name = document.createElement('b');
      name.textContent = b.name;
      const meta = document.createElement('small');
      const sp = SPECIES[Number(b.species ?? 0)]?.[0] ?? '';
      meta.textContent = `${bugId(b.bug_number)} · ${roleLabel(b.role)}${sp ? ' · ' + sp : ''}`;
      // challenge this bug to a Bug Duel in the Lunapark
      const duel = document.createElement('span');
      duel.className = 'sw-duel';
      duel.setAttribute('role', 'link');
      duel.tabIndex = 0;
      duel.textContent = 'Duel ⚔';
      duel.setAttribute('aria-label', `Challenge ${bugId(b.bug_number)} to a Bug Duel`);
      const goDuel = (e: Event) => { e.preventDefault(); e.stopPropagation(); location.href = `/inside/lunapark?duel=${b.bug_number}`; };
      duel.addEventListener('click', goDuel);
      duel.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') goDuel(e); });
      card.append(tile, name, meta, duel);
      card.addEventListener('click', (e) => { e.preventDefault(); find(b.bug_number); stage.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
      grid.appendChild(card);
    }
    $('sw-count').textContent = String(bugs.length);
    $('sw-empty').hidden = bugs.length > 0;
  }

  function find(n: number | null) {
    const found = orbit.highlight(n, n !== null && n === mine ? 'YOU' : 'HERE');
    $('sw-find').textContent = n === null ? 'Find my bug' : 'Show everyone';
    $('sw-msg').textContent = n !== null && !found ? `${bugId(n)} is not in the swarm (yet).` : '';
  }

  async function start() {
    if (!supabase) { $('sw-empty').hidden = false; $('sw-empty').textContent = 'The swarm is not connected on this site yet.'; return; }
    const { data, error } = await supabase.rpc('get_swarm', { max_rows: 1000 });
    if (error) { $('sw-msg').textContent = 'Could not load the swarm. Try again in a moment.'; return; }
    bugs = (data ?? []) as SwarmBug[];
    orbit.set(bugs);
    renderGrid();

    const hl = new URLSearchParams(location.search).get('highlight');
    if (hl !== null && /^\d+$/.test(hl)) find(Number(hl));

    const { data: s } = await supabase.auth.getSession();
    if (s.session) {
      const { data: me } = await supabase.from('bugs').select('bug_number').eq('user_id', s.session.user.id).maybeSingle();
      if (me) { mine = me.bug_number; $('sw-find').hidden = false; }
    }

    onNewBug((b) => {
      bugs.unshift(b);
      orbit.add(b);
      renderGrid();
    });
  }

  $('sw-find').addEventListener('click', () => {
    const on = $('sw-find').textContent === 'Find my bug';
    find(on ? mine : null);
    track('swarm_find', on ? 'on' : 'off');
  });
  $('sw-pause').addEventListener('click', () => { $('sw-pause').textContent = orbit.togglePause() ? 'Play' : 'Pause'; });
  $('sw-fs').addEventListener('click', () => {
    const r = stage.requestFullscreen?.();
    if (!r) { $('sw-msg').textContent = 'Full screen is not available here.'; return; }
    r.catch(() => { $('sw-msg').textContent = 'Full screen is not available here.'; });
  });

  start();
</script>

<script>
  // outbreak tree and ragequit ghosts
  import { supabase } from '../lib/supabase';
  import { bugSVG } from '../lib/bug/render.js';

  type Edge = { from_bug: number; to_bug: number; at: string };
  type B = { bug_number: number; name: string; config: Record<string, string | number | undefined> };
  const id = (n: number | null) => n == null ? 'BUG-????' : `BUG-${String(n).padStart(4, '0')}`;

  function node(n: number, bugs: Map<number, B>) {
    const span = document.createElement('span'); span.className = 'ob-node';
    const b = bugs.get(n);
    if (b) span.innerHTML = bugSVG(b.config, 60);
    span.append(document.createTextNode(`${id(n)}${b ? ' · ' + b.name : ''}`));
    return span;
  }

  function branch(n: number, kids: Map<number, number[]>, bugs: Map<number, B>, depth = 0): HTMLElement {
    const wrap = document.createElement('div');
    wrap.append(node(n, bugs));
    const list = kids.get(n) ?? [];
    if (list.length && depth < 12) {
      const ul = document.createElement('ul'); ul.className = 'ob-kids';
      for (const k of list) { const li = document.createElement('li'); li.append(branch(k, kids, bugs, depth + 1)); ul.append(li); }
      wrap.append(ul);
    }
    return wrap;
  }

  async function outbreak() {
    const box = document.getElementById('ob-tree')!;
    if (!supabase) { box.innerHTML = '<p class="ob-empty">Not connected yet.</p>'; return; }
    const [{ data: edges, error }, { data: swarm }] = await Promise.all([
      supabase.rpc('infection_tree'),
      supabase.rpc('get_swarm', { max_rows: 1000 }),
    ]);
    if (error) { box.innerHTML = '<p class="ob-empty">The outbreak map is not installed yet.</p>'; return; }
    const list = (edges ?? []) as Edge[];
    if (!list.length) { box.innerHTML = '<p class="ob-empty">Patient zero is still waiting. Members: open a vial in Inside → Infect.</p>'; return; }
    const bugs = new Map(((swarm ?? []) as B[]).map((b) => [b.bug_number, b]));
    const kids = new Map<number, number[]>();
    const infected = new Set<number>();
    for (const e of list) { kids.set(e.from_bug, [...(kids.get(e.from_bug) ?? []), e.to_bug]); infected.add(e.to_bug); }
    const roots = [...kids.keys()].filter((n) => !infected.has(n));
    box.replaceChildren(...roots.map((r) => { const c = document.createElement('div'); c.className = 'ob-chain'; c.append(branch(r, kids, bugs)); return c; }));
  }

  async function ghosts() {
    const box = document.getElementById('gh-wall')!;
    if (!supabase) { box.innerHTML = ''; return; }
    const { data, error } = await supabase.rpc('ghost_wall', { p_limit: 40 });
    if (error) { box.innerHTML = '<p class="ob-empty">The ghost wall is not installed yet.</p>'; return; }
    const rows = (data ?? []) as { bug_number: number | null; config: Record<string, string | number | undefined> | null; message: string | null; left_at: string }[];
    if (!rows.length) { box.innerHTML = '<p class="ob-empty">Nobody has ragequit. Yet.</p>'; return; }
    box.replaceChildren(...rows.map((g) => {
      const card = document.createElement('article'); card.className = 'gh-card';
      if (g.config) card.innerHTML = bugSVG(g.config, 160);
      const q = document.createElement('blockquote'); q.textContent = g.message ? `“${g.message}”` : '…';
      const s = document.createElement('small'); s.textContent = `${id(g.bug_number)} · left ${new Date(g.left_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}`;
      card.append(q, s);
      return card;
    }));
  }

  outbreak();
  ghosts();
</script>
