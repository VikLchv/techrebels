---
// Password login for existing applicants, members and admins.
import Club from '../layouts/Club.astro';
---
<Club title="Log in · techRebels" description="Log in to techRebels with your email and password.">
  <section class="block first login">
    <div class="login-card">
      <p class="eyebrow">Members</p>
      <h1 class="h2">Get inside.</h1>
      <p class="lede">Use the email and password connected to your techRebels account.</p>
      <form id="login-form" novalidate>
        <label>Email<input type="email" id="login-email" required autocomplete="email" maxlength="120" /></label>
        <label>Password<input type="password" id="login-password" required autocomplete="current-password" minlength="12" maxlength="128" /></label>
        <p class="lerr" id="login-err" role="alert" hidden></p>
        <div class="login-actions"><button class="pill pill-pink" type="submit" id="login-send">Log in <span aria-hidden="true">→</span></button><a href="/forgot-password">Forgot password?</a></div>
      </form>
      <p class="login-new">New here? <a href="/lab">Build your bug and apply</a>. Used a magic link before? <a href="/forgot-password">Set your password</a>.</p>
    </div>
  </section>
</Club>

<style is:global>
  .login-card { max-width: 560px; display: grid; gap: 18px; }
  .login-card form { display: grid; gap: 14px; }
  .login-card label { display: grid; gap: 7px; font-weight: 700; }
  .login-card input { font: 500 1rem "Satoshi", system-ui, sans-serif; color: var(--bone); background: var(--night-2); border: 1.5px solid rgba(237, 231, 220, .16); border-radius: 14px; padding: 13px 15px; }
  .login-card input:focus { outline: none; border-color: var(--lime); }
  .login-card .pill { justify-self: start; }
  .login-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .login-actions a, .login-new a { color: var(--mint); }
  .login-new { margin: 0; color: var(--muted); }
  .lerr { margin: 0; color: var(--pink); font-weight: 700; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const requestedNext = new URLSearchParams(location.search).get('next');
  const next = requestedNext?.startsWith('/') && !requestedNext.startsWith('//') ? requestedNext : '/inside';

  if (supabase) supabase.auth.getSession().then(({ data }) => { if (data.session) location.replace(next); });

  const form = document.getElementById('login-form') as HTMLFormElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('login-email') as HTMLInputElement;
    const password = document.getElementById('login-password') as HTMLInputElement;
    const err = document.getElementById('login-err')!;
    err.hidden = true;
    if (!email.value || !email.checkValidity()) { err.textContent = 'Please enter a valid email.'; err.hidden = false; email.focus(); return; }
    if (!password.value) { err.textContent = 'Please enter your password.'; err.hidden = false; password.focus(); return; }
    if (!supabase) { err.textContent = 'Log in is not connected on this site yet.'; err.hidden = false; return; }
    const btn = document.getElementById('login-send') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await supabase.auth.signInWithPassword({ email: email.value.trim(), password: password.value });
    btn.disabled = false;
    if (error?.status === 429) { err.textContent = 'Too many login attempts. Try again in a few minutes.'; err.hidden = false; return; }
    if (error) { err.textContent = 'Email or password is incorrect. If you used magic links before, set a password first.'; err.hidden = false; return; }
    location.replace(next);
  });
</script>
